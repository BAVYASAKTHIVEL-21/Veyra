<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VEYRA — Crime Scene Intelligence & Connected Threat Forensics</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        obsidian: '#070709',
                        midnightNavy: '#0B0B10',
                        cardbg: '#101015',
                        cautionYellow: '#FFCC00',
                        alertRed: '#FF2A2A',
                        classifiedGray: '#181820'
                    },
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace']
                    }
                }
            }
        }
    </script>
    <!-- Three.js for 3D Graph & Particles -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
    <style>
        .nav-icon {
            position: relative;
            display: flex;
            width: 42px;
            height: 42px;
            flex: 0 0 auto;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(255,255,255,.12);
            border-radius: 11px;
            background: rgba(255,255,255,.045);
            color: #CBD5E1;
            transition: color .18s ease, border-color .18s ease, background .18s ease;
        }
        .nav-icon svg {
            width: 21px;
            height: 21px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }
        .nav-icon:hover, .nav-icon:focus-visible, .nav-icon[aria-current="page"] {
            color: #FFCC00;
            border-color: #FFCC00;
            background: rgba(255,204,0,.10);
            outline: none;
        }
        .nav-tooltip {
            position: absolute;
            top: calc(100% + 10px);
            left: 50%;
            z-index: 100;
            transform: translate(-50%, -4px);
            padding: 7px 10px;
            border: 1px solid rgba(255,204,0,.45);
            border-radius: 6px;
            background: #101015;
            color: #FFCC00;
            font: 600 11px/1.4 "JetBrains Mono", monospace;
            white-space: nowrap;
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transition: opacity .15s ease, transform .15s ease, visibility .15s;
        }
        .nav-icon:hover .nav-tooltip, .nav-icon:focus-visible .nav-tooltip {
            opacity: 1;
            visibility: visible;
            transform: translate(-50%, 0);
        }
        @media (max-width: 640px) {
            .nav-icon { width: 34px; height: 34px; }
            .nav-icon svg { width: 18px; height: 18px; }
            .nav-tooltip { font-size: 10px; }
        }


        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #070709;
            color: #E2E8F0;
            overflow-x: hidden;
            margin: 0;
            padding: 0;
        }
        .mono {
            font-family: 'JetBrains Mono', monospace;
        }

        @keyframes topStripeMove {
            0% { background-position: 0 0; }
            100% { background-position: 32px 0; }
        }

        @keyframes diagonalSweep1 {
            0% {
                transform: translate(-120vw, -120vh) rotate(-32deg);
                opacity: 0;
            }
            15% { opacity: 0.65; }
            85% { opacity: 0.65; }
            100% {
                transform: translate(140vw, 140vh) rotate(-32deg);
                opacity: 0;
            }
        }

        @keyframes diagonalSweep2 {
            0% {
                transform: translate(140vw, -120vh) rotate(32deg);
                opacity: 0;
            }
            15% { opacity: 0.65; }
            85% { opacity: 0.65; }
            100% {
                transform: translate(-140vw, 140vh) rotate(32deg);
                opacity: 0;
            }
        }

        /* Thinner, delicate top hazard line (approx 4px) */
        .top-hazard-stripe {
            height: 4px;
            width: 100%;
            background: repeating-linear-gradient(
                -45deg,
                #FFCC00,
                #FFCC00 16px,
                #070709 16px,
                #070709 32px
            );
            background-size: 32px 4px;
            animation: topStripeMove 1.8s linear infinite;
            border-bottom: 1px solid rgba(255, 204, 0, 0.15);
        }

        /* Slim 3.5px cinematic diagonal sweepers crossing viewport cleanly */
        .diagonal-sweep-1 {
            position: fixed;
            top: -50%;
            left: -50%;
            width: 250vw;
            height: 3.5px;
            background: repeating-linear-gradient(
                -45deg,
                #FFCC00,
                #FFCC00 14px,
                #070709 14px,
                #070709 28px
            );
            opacity: 0;
            pointer-events: none;
            z-index: 5;
            animation: diagonalSweep1 7s linear infinite;
            animation-delay: 0s;
            box-shadow: 0 0 4px rgba(255, 204, 0, 0.1);
        }

        .diagonal-sweep-2 {
            position: fixed;
            top: -50%;
            left: -50%;
            width: 250vw;
            height: 3.5px;
            background: repeating-linear-gradient(
                45deg,
                #FFCC00,
                #FFCC00 14px,
                #070709 14px,
                #070709 28px
            );
            opacity: 0;
            pointer-events: none;
            z-index: 5;
            animation: diagonalSweep2 8.5s linear infinite;
            animation-delay: 3.5s;
            box-shadow: 0 0 4px rgba(255, 204, 0, 0.1);
        }

        @keyframes floatMotion {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-4px); }
        }
        .motion-float {
            animation: floatMotion 6s ease-in-out infinite;
        }

        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #070709;
        }
        ::-webkit-scrollbar-thumb {
            background: #22222D;
            border-radius: 3px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #FFCC00;
        }
    </style>

<style>
/* VEYRA_INVESTIGATION_ANIMATION_ISOLATION */

/* Hide the actual diagonal sweep elements only during investigations. */
html.veyra-investigation-open .diagonal-sweep-1,
html.veyra-investigation-open .diagonal-sweep-2,
body.veyra-investigation-open .diagonal-sweep-1,
body.veyra-investigation-open .diagonal-sweep-2 {
  animation: none !important;
  opacity: 0 !important;
  visibility: hidden !important;
}

</style>
<style>
    /* VEYRA_INVESTIGATION_STRIPE_FIX */
    html.veyra-investigation-open .top-hazard-stripe,
    body.veyra-investigation-open .top-hazard-stripe,
    html.veyra-investigation-open .diagonal-sweep-1,
    html.veyra-investigation-open .diagonal-sweep-2,
    body.veyra-investigation-open .diagonal-sweep-1,
    body.veyra-investigation-open .diagonal-sweep-2 {
      display: none !important;
      animation: none !important;
    }
    </style>
</head>
<body class="bg-obsidian min-h-screen flex flex-col relative selection:bg-[#FFCC00] selection:text-black">

    <div class="diagonal-sweep-1"></div>
    <div class="diagonal-sweep-2"></div>

    <div class="top-hazard-stripe"></div>

    <header class="w-full px-8 py-4 flex items-center justify-between z-40 border-b border-white/10 bg-obsidian/95 backdrop-blur-md sticky top-0 shrink-0">
        <div class="flex items-center space-x-3.5">
            <div class="w-10 h-10 rounded-lg bg-[#FFCC00] text-black flex items-center justify-center shadow-lg transform -rotate-3 hover:rotate-0 transition-transform relative overflow-hidden">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <circle cx="10" cy="10" r="6" stroke-width="2.5"></circle>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14.5 14.5L20 20"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 8h4m-2-2v4"></path>
                </svg>
            </div>
            <div class="flex items-baseline space-x-2">
                <span class="text-xl font-extrabold tracking-wider text-white">VEYRA</span>
                <span class="text-[9px] tracking-widest text-[#FFCC00] mono font-bold bg-[#FFCC00]/10 px-2 py-0.5 rounded border border-[#FFCC00]/35">CRIME SCENE INTELLIGENCE</span>
            </div>
        </div>
        <nav aria-label="Main navigation"
             class="absolute left-1/2 -translate-x-1/2 flex items-center gap-2 z-50">
            <a href="#home" data-veyra-view="home" aria-label="Home"
               class="nav-icon" >
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg>
                <span class="nav-tooltip">Home — Landing page</span>
            </a>
            <a href="#dms" data-veyra-view="dms" aria-label="Direct messages"
               class="nav-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 11.5a8.5 8.5 0 0 1-12.3 7.6L3 21l1.8-5.7A8.5 8.5 0 1 1 21 11.5Z"/></svg>
                <span class="nav-tooltip">DMs — Message simulator</span>
            </a>

            <a href="#cases" data-veyra-view="cases" aria-label="Cases"
               class="nav-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h5l2 2h7a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M3 10h18"/></svg>
                <span class="nav-tooltip">Cases — Saved investigations</span>
            </a>
        </nav>

        <div class="flex items-center space-x-6">
            <a href="#documentation" class="text-sm font-semibold text-slate-300 hover:text-[#FFCC00] transition-colors">Documentation</a>
        </div>
    </header>

    <main class="flex-1 flex items-center px-6 lg:px-16 py-8 z-10 max-w-[1700px] mx-auto w-full relative">
        <div class="w-full grid grid-cols-1 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] gap-10 lg:gap-14 items-center">
            
            <div class="flex flex-col justify-center space-y-7 w-full min-w-0 z-20">
                
                <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded bg-[#FFCC00]/15 border border-[#FFCC00]/40 text-[#FFCC00] text-xs font-bold tracking-widest uppercase self-start shadow-lg">
                    <span class="w-2 h-2 rounded-full bg-[#FFCC00] animate-ping"></span>
                    <span>CONNECTED EVIDENCE &bull; THREAT FORENSICS</span>
                </div>

                <h1 class="text-4xl sm:text-6xl lg:text-[68px] font-extrabold tracking-tight leading-[1.05] m-0 motion-float">
                    <span class="block">
                        <span class="text-white">Uncover the</span> <span class="text-[#FFCC00]">network.</span>
                    </span>
                    <span class="block mt-1">
                        <span class="text-white">Expose the</span> <span class="text-[#FFCC00]">threat.</span>
                    </span>
                </h1>

                <!-- Supporting Description -->
                <p class="text-base sm:text-[18px] text-slate-300 font-normal leading-relaxed max-w-2xl m-0">
                    Veyra connects suspicious accounts, malicious URLs, domains, impersonated brands, and reported activity to reveal hidden relationships and turn digital evidence into actionable intelligence.
                </p>

                <div class="p-5 rounded-xl bg-cardbg/95 border border-[#FFCC00]/40 max-w-2xl space-y-3 shadow-2xl relative overflow-hidden backdrop-blur-md">
                    <div class="flex items-center justify-between pt-1">
                        <h3 class="text-sm font-bold text-white tracking-wide m-0 flex items-center space-x-2">
                            <span class="w-2 h-2 rounded-full bg-[#FFCC00] animate-pulse"></span>
                            <span>Powered by FalkorDB Graph Engine</span>
                        </h3>
                        <div id="db-status" class="text-[9px] mono text-[#FFCC00] bg-[#FFCC00]/15 px-2 py-0.5 rounded border border-[#FFCC00]/40 font-bold">
                            FETCHING LIVE DB...
                        </div>
                    </div>
                    <p class="text-xs sm:text-sm text-slate-300 leading-relaxed m-0">
                        FalkorDB is a graph database designed to query connected data efficiently. Veyra retrieves live graph data to explore links between accounts, domains, URLs, brands, reports, and evidence.
                    </p>
                    <div class="flex flex-wrap gap-2 pt-1">
                        <span class="px-2.5 py-1 rounded bg-[#FFCC00]/15 border border-[#FFCC00]/40 text-[#FFCC00] text-[11px] mono font-bold">Connected Evidence</span>
                        <span class="px-2.5 py-1 rounded bg-white/5 border border-white/10 text-slate-300 text-[11px] mono font-semibold">Relationship Traversal</span>
                        <span class="px-2.5 py-1 rounded bg-white/5 border border-white/10 text-slate-300 text-[11px] mono font-semibold">Explainable Investigations</span>
                    </div>
                </div>

            <div class="pt-2">
                <button
                    type="button"
                    onclick="showInvestigation(); return false;"
                    class="px-8 py-3.5 rounded-xl bg-[#FFCC00] text-black font-extrabold text-sm hover:bg-[#e6b800] transition-all inline-flex items-center gap-3 cursor-pointer">
                    <span>Start Investigation</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
                            d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                </button>
            </div>

            </div>

            <div class="relative flex flex-col items-center justify-center w-full h-full z-20">
                <div class="w-full h-[520px] lg:h-[600px] relative overflow-visible flex items-center justify-center bg-transparent">
                    <div id="graph-container" class="w-full h-full cursor-grab active:cursor-grabbing absolute inset-0 bg-transparent"></div>

                    <!-- Floating Tooltip Card -->
                    <div id="graph-tooltip" class="absolute bottom-4 left-4 right-4 z-30 bg-cardbg/95 border border-[#FFCC00] p-3.5 rounded-xl text-xs mono shadow-[0_0_30px_rgba(255,204,0,0.4)] transition-all duration-150 opacity-0 pointer-events-none backdrop-blur-md">
                        <div class="flex items-center justify-between mb-1">
                            <span id="tooltip-type" class="text-[#FFCC00] font-bold uppercase tracking-wider text-[10px]">EVIDENCE NODE</span>
                            <span id="tooltip-id" class="text-slate-300 text-[10px]">ID: #000</span>
                        </div>
                        <div id="tooltip-title" class="text-white font-semibold text-xs mb-0.5">Select a node or edge</div>
                        <div id="tooltip-details" class="text-slate-200 text-[10px]">Hover or drag any node in the crime scene network.</div>
                    </div>
                </div>
            </div>

        </div>
    </main>

    <footer class="w-full py-4 px-8 border-t border-white/10 text-center text-xs text-slate-400 mono shrink-0 z-20 flex flex-col sm:flex-row items-center justify-between bg-obsidian">
        <span>VEYRA Cyber-Forensics Intelligence Platform v3.2</span>
        <span class="text-[#FFCC00]">RESTRICTED ACCESS &bull; FALKORDB SECURED</span>
    </footer>

        <!-- VIEW 2: NEW INVESTIGATION WORKSPACE (SINGLE-PAGE COMPACT LAYOUT) -->
    <div id="view-new-investigation" class="flex-1 flex flex-col px-4 py-2 max-w-[1400px] mx-auto w-full hidden overflow-hidden justify-center">


        
        <!-- Compact Header & Scenario Selector Bar -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-2 mb-2 shrink-0">
            <div>
                <div class="inline-flex items-center space-x-2 px-2 py-0.5 rounded bg-[#FFCC00]/10 border border-[#FFCC00]/30 text-[#FFCC00] text-[9px] font-bold tracking-widest uppercase mb-0.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#FFCC00] animate-pulse"></span>
                    <span>SIMULATION &bull; SYNTHETIC DEMONSTRATION DATA</span>
                </div>
                <h1 class="text-lg lg:text-xl font-extrabold text-white tracking-tight">DM Simulator</h1>
            </div>
            
            <!-- Message Scenario Selector & Simulate Button -->
            <div class="flex items-center gap-2 bg-cardbg/90 border border-white/10 p-1.5 rounded-xl shadow-lg">
                <div class="flex flex-col">
                    <label class="text-[8px] mono text-slate-400 font-bold uppercase mb-0.5">Message Scenario</label>
                    <select id="modal-scenario-select" class="bg-obsidian border border-white/20 rounded-lg px-2 py-1 text-xs text-white focus:border-[#FFCC00] focus:outline-none">
                        <option value="normal_friend">1. Normal message from a friend</option>
                        <option value="suspicious_friend">2. Suspicious message from a friend</option>
                        <option value="hacked_friend">3. Hacked friend's account</option>
                        <option value="fake_business">4. Fake business account</option>
                        <option value="verification_scam">5. Account verification scam</option>
                        <option value="investment_scam" selected>6. Investment or giveaway scam</option>
                    </select>
                </div>
                <div class="flex flex-col justify-end">
                    <button onclick="triggerSimulateNewDm()" class="px-3 py-1.5 rounded-lg bg-[#FFCC00] text-black font-extrabold text-xs hover:bg-[#e6b800] transition-all flex items-center space-x-1 cursor-pointer shadow-md mt-3.5">
                        <span>+ Simulate Incoming DM</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Side-by-Side Main Grid (Fits strictly within 100vh viewport) -->
        <div class="grid grid-cols-1 lg:grid-cols-[360px_1fr] gap-4 items-start flex-1 overflow-hidden pb-2">
            
            <!-- Left Panel: Instructions & Active Investigation Case Summary -->
            <div class="bg-cardbg border border-white/10 rounded-2xl p-4 space-y-3 shadow-xl overflow-y-auto max-h-[calc(100vh-140px)]">
                <div>
                    <span class="text-[9px] font-bold mono text-[#FFCC00] uppercase block mb-0.5">Workflow Guide</span>
                    <h3 class="text-white font-bold text-sm">Interactive Forensics</h3>
                </div>

                <div class="space-y-2 text-[11px] text-slate-300 leading-relaxed">
                    <div class="flex items-start space-x-2 p-2 rounded-xl bg-obsidian/70 border border-white/10">
                        <span class="w-4 h-4 rounded-full bg-[#FFCC00] text-black font-extrabold flex items-center justify-center shrink-0 text-[10px]">1</span>
                        <div><strong class="text-white">Simulate DM:</strong> Select any scenario above and click <strong class="text-[#FFCC00]">+ Simulate Incoming DM</strong> to inject it into the phone inbox as an unread message with a <strong class="text-[#FFCC00]">NEW</strong> badge.</div>
                    </div>
                    <div class="flex items-start space-x-2 p-2 rounded-xl bg-obsidian/70 border border-white/10">
                        <span class="w-4 h-4 rounded-full bg-[#FFCC00] text-black font-extrabold flex items-center justify-center shrink-0 text-[10px]">2</span>
                        <div><strong class="text-white">Open Inbox & Chat:</strong> Tap the phone screen to browse conversations, open unread DMs, and send simulated replies.</div>
                    </div>
                    <div class="flex items-start space-x-2 p-2 rounded-xl bg-obsidian/70 border border-white/10">
                        <span class="w-4 h-4 rounded-full bg-[#FFCC00] text-black font-extrabold flex items-center justify-center shrink-0 text-[10px]">3</span>
                        <div><strong class="text-white">Investigate Message:</strong> Tap any message bubble in chat to select it, then click <strong class="text-[#FFCC00]">Investigate with Veyra</strong> to trigger FalkorDB multi-hop traversal.</div>
                    </div>
                </div>

                <!-- Investigation Result Panel (Appears after investigating a message) -->
                <div id="investigation-result-wrapper" class="pt-2.5 border-t border-white/10 hidden space-y-2">
                    <div class="flex items-center justify-between">
                        <span class="text-[9px] mono text-[#FFCC00] uppercase font-bold">FalkorDB Evidence Report</span>
                        <span id="case-id-badge" class="text-[9px] mono bg-white/10 text-white px-2 py-0.5 rounded">CASE #000</span>
                    </div>
                    <div id="result-status-banner" class="p-2 rounded-xl text-xs font-bold mono text-center">CLASSIFYING...</div>
                    <div id="result-explanation" class="p-2.5 rounded-xl bg-obsidian border border-white/10 text-[11px] text-slate-300 space-y-1">
                        Analyzing connected evidence...
                    </div>
                    <button onclick="openActiveCaseDetails()" class="w-full py-2 rounded-xl bg-[#FFCC00] text-black font-extrabold text-xs flex items-center justify-center space-x-2 hover:bg-[#e6b800] cursor-pointer">
                        <span>View Case & Ask Veyra Agent →</span>
                    </button>
                </div>
            </div>

            <!-- Right Panel: Proportional iPhone 17 Pro Hardware Mockup (Fits Viewport) -->
            <div class="flex flex-col items-center justify-center w-full h-full bg-cardbg/40 border border-white/10 rounded-2xl p-2 relative overflow-hidden">
                
                <!-- iPhone Hardware Outer Shell (Scaled to fit viewport height ~560px) -->
                <div id="iphone-device" class="w-[300px] h-[560px] bg-[#1a1a1f] p-[8px] rounded-[42px] shadow-[0_20px_50px_rgba(0,0,0,0.9),_0_0_0_2px_rgba(255,255,255,0.15)] flex flex-col relative select-none shrink-0">
                    
                    <!-- iPhone Screen Inner Area -->
                    <div class="w-full h-full bg-obsidian rounded-[34px] overflow-hidden flex flex-col relative border border-black">
                        
                        <!-- iPhone Status Bar & Dynamic Island -->
                        <div class="bg-black px-5 py-2 flex items-center justify-between text-[10px] text-white font-semibold shrink-0 z-40 select-none">
                            <span>9:41</span>
                            <!-- Dynamic Island -->
                            <div class="w-22 h-3.5 bg-black rounded-full absolute left-1/2 transform -translate-x-1/2 top-2 flex items-center justify-between px-2 border border-white/10 shadow-sm">
                                <div class="w-2 h-2 rounded-full bg-neutral-900 border border-neutral-800"></div>
                                <div class="w-1.5 h-1.5 rounded-full bg-neutral-950"></div>
                            </div>
                            <div class="flex items-center space-x-1 text-slate-300">
                                <span>5G</span>
                                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24"><path d="M12 3c-4.97 0-9 4.03-9 9 0 2.12.74 4.07 1.97 5.61L4.35 19h15.3l-1.62-1.39C19.26 16.07 20 14.12 20 12c0-4.97-4.03-9-9-9z"/></svg>
                            </div>
                        </div>

                        <!-- IPHONE VIEW 1: DM INBOX -->
                        <div id="phone-inbox-view" class="flex-1 flex flex-col overflow-hidden bg-obsidian relative">
                            <!-- Instagram DM Header -->
                            <div class="px-3 py-2 flex items-center justify-between border-b border-white/10 shrink-0 bg-obsidian">
                                <div class="flex items-center space-x-2">
                                    <span class="text-white font-extrabold text-sm tracking-tight">Your messages</span>
                                    <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
                                </div>
                                <div class="flex items-center space-x-2 text-white">
                                    <span class="text-[9px] px-1.5 py-0.5 rounded bg-[#FFCC00]/15 text-[#FFCC00] font-mono font-bold">DM INBOX</span>
                                </div>
                            </div>

                            <!-- Search Box -->
                            <div class="px-3 py-1.5 shrink-0 bg-obsidian">
                                <div class="bg-classifiedGray border border-white/10 rounded-lg px-2.5 py-1 flex items-center space-x-2 text-[11px] text-slate-400">
                                    <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
                                    <span>Search messages, accounts...</span>
                                </div>
                            </div>

                            <!-- Conversations List (Scrollable inside phone) -->
                            <div id="phone-conversations-list" class="flex-1 overflow-y-auto divide-y divide-white/5">
                                <!-- Populated dynamically -->
                            </div>

                            <!-- Bottom Mobile Navigation Bar -->
                            <div class="py-2 px-6 border-t border-white/10 flex items-center justify-between text-slate-400 bg-obsidian shrink-0">
                                <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
                                <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                                <svg class="w-4 h-4 text-[#FFCC00]" fill="currentColor" viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 9h12v2H6V9zm8 5H6v-2h8v2zm4-6H6V6h12v2z"/></svg>
                                <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                            </div>
                        </div>

                        <!-- IPHONE VIEW 2: ACTIVE CHAT VIEW -->
                        <div id="phone-chat-view" class="flex-1 flex flex-col overflow-hidden bg-obsidian hidden relative">
                            <!-- Chat Header -->
                            <div class="px-3 py-2 flex items-center justify-between border-b border-white/10 bg-obsidian shrink-0">
                                <div class="flex items-center space-x-2">
                                    <button onclick="backToInbox()" class="text-white hover:text-[#FFCC00] p-1 cursor-pointer">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
                                    </button>
                                    <div class="flex items-center space-x-2">
                                        <div id="active-chat-avatar" class="w-6 h-6 rounded-full bg-[#FFCC00]/20 border border-[#FFCC00] flex items-center justify-center text-[#FFCC00] font-bold text-[9px]">
                                            EM
                                        </div>
                                        <div>
                                            <div class="flex items-center space-x-1">
                                                <h4 id="active-chat-username" class="text-white font-bold text-[11px]">@emma_watson_99</h4>
                                                <span id="active-chat-verified" class="text-sky-400 text-[9px]">✔</span>
                                            </div>
                                            <span class="text-[8px] text-slate-400 mono">Active 2m ago</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="flex items-center space-x-2 text-slate-300">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                                </div>
                            </div>

                            <!-- Chat Messages Scrollable Body (Inside Phone) -->
                            <div id="active-chat-messages" class="flex-1 p-3 overflow-y-auto space-y-2 bg-obsidian/80">
                                <!-- Populated dynamically with selectable message bubbles -->
                            </div>

                            <!-- Selected Message Investigation Overlay / Action Bar (Inside Phone) -->
                            <div id="selected-message-action-bar" class="p-2 bg-classifiedGray/95 border-t border-[#FFCC00]/40 hidden shrink-0 space-y-1 backdrop-blur-md z-25">
                                <div class="flex items-center justify-between text-[9px] mono text-[#FFCC00] font-bold">
                                    <span>SELECTED MESSAGE FOR INVESTIGATION</span>
                                    <button onclick="clearSelectedMessage()" class="text-slate-400 hover:text-white">✕</button>
                                </div>
                                <div id="selected-msg-preview-text" class="text-[10px] text-slate-300 truncate">
                                    "Hey! Are we meeting this evening?"
                                </div>
                                <button onclick="executeVeyraInvestigationOnSelected()" class="w-full py-1.5 rounded-lg bg-[#FFCC00] text-black font-extrabold text-[10px] hover:bg-[#e6b800] transition-all flex items-center justify-center space-x-1 cursor-pointer shadow-md">
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                                    <span>Investigate with Veyra</span>
                                </button>
                            </div>

                            <!-- Phone Bottom Interactive Chat Composer Bar -->
                            <div class="bg-obsidian border-t border-white/10 p-2 flex items-center space-x-2 shrink-0">
                                <button class="w-5 h-5 rounded-full bg-classifiedGray text-slate-300 hover:text-white flex items-center justify-center text-[9px] font-bold border border-white/10 shrink-0" title="Attach">📎</button>
                                <input type="text" id="chat-message-input" placeholder="Message..." class="flex-1 bg-classifiedGray border border-white/10 rounded-full px-3 py-1 text-[10px] text-white focus:border-[#FFCC00] focus:outline-none" onkeydown="handleChatInputKeydown(event)">
                                <button onclick="sendUserChatMessage()" class="w-5 h-5 rounded-full bg-[#FFCC00] text-black flex items-center justify-center text-[9px] font-bold hover:bg-[#e6b800] transition-all shrink-0 cursor-pointer" title="Send">
                                    <svg class="w-3 h-3 transform rotate-90" fill="currentColor" viewBox="0 0 24 24"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
                                </button>
                            </div>
                        </div>

                        <!-- iPhone Home Indicator Bar at Bottom -->
                        <div class="h-3 bg-black flex items-center justify-center shrink-0">
                            <div class="w-24 h-0.5 bg-white/30 rounded-full"></div>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>

        <!-- VIEW 3: CASES & ASK VEYRA AGENT Q&A -->
    <div id="view-cases" class="flex-1 flex flex-col p-6 lg:p-12 max-w-[1400px] mx-auto w-full hidden overflow-y-auto">
        <div class="mb-6 flex items-center justify-between shrink-0">
            <div>
                <h1 class="text-2xl font-extrabold text-white tracking-tight mb-1">Investigation Cases & Agent Q&A</h1>
                <p class="text-slate-300 text-xs">Persistent threat intelligence cases stored in FalkorDB with interactive AI agent query support.</p>
            </div>
            <button onclick="switchView('new-investigation')" class="px-4 py-2 rounded-xl bg-[#FFCC00] text-black font-extrabold text-xs cursor-pointer">New Investigation</button>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-[1fr_420px] gap-6 flex-1">
            <!-- Cases Table -->
            <div class="bg-cardbg border border-white/10 rounded-2xl p-5 overflow-hidden flex flex-col">
                <h3 class="text-white font-bold text-sm mb-3">Saved Investigation Records</h3>
                <div class="overflow-x-auto flex-1">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-white/10 text-[10px] mono text-slate-400">
                                <th class="py-2.5 px-3">Case ID</th>
                                <th class="py-2.5 px-3">Sender / Target</th>
                                <th class="py-2.5 px-3">Classification</th>
                                <th class="py-2.5 px-3">Created</th>
                                <th class="py-2.5 px-3 text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody id="cases-table-body" class="text-xs text-slate-300 divide-y divide-white/5">
                            <tr>
                                <td colspan="5" class="py-6 text-center text-slate-500 italic">No active cases loaded. Run an investigation to create one.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Ask Veyra About This Case Chat Panel -->
            <div class="bg-cardbg border border-[#FFCC00]/40 rounded-2xl p-5 flex flex-col h-[520px] shadow-xl">
                <div class="flex items-center justify-between pb-3 border-b border-white/10">
                    <div class="flex items-center space-x-2">
                        <div class="w-2.5 h-2.5 rounded-full bg-[#FFCC00] animate-pulse"></div>
                        <h3 class="text-white font-bold text-xs">Ask Veyra About This Case</h3>
                    </div>
                    <span id="active-agent-case-id" class="text-[9px] mono bg-[#FFCC00]/10 text-[#FFCC00] px-2 py-0.5 rounded border border-[#FFCC00]/30 font-bold">NO CASE SELECTED</span>
                </div>

                <!-- Chat History Area -->
                <div id="agent-chat-messages" class="flex-1 overflow-y-auto py-3 space-y-2.5 text-xs">
                    <div class="p-2.5 rounded-xl bg-classifiedGray border border-white/10 text-slate-300">
                        Select a case and ask questions like:
                        <ul class="list-disc list-inside mt-1 space-y-0.5 text-[#FFCC00] mono text-[11px]">
                            <li>What happened in this case?</li>
                            <li>Why was this message flagged?</li>
                            <li>Which account sent the message?</li>
                            <li>How is the account connected to the payment identifier?</li>
                            <li>Show the multi-hop connection path.</li>
                        </ul>
                    </div>
                </div>

                <!-- Chat Input Bar -->
                <div class="pt-3 border-t border-white/10 flex items-center space-x-2">
                    <input type="text" id="agent-chat-input" placeholder="Ask Veyra agent about FalkorDB graph relationships..." class="flex-1 bg-obsidian border border-white/20 rounded-xl px-3 py-2 text-xs text-white focus:border-[#FFCC00] focus:outline-none">
                    <button onclick="sendAgentChatMessage()" class="px-3.5 py-2 rounded-xl bg-[#FFCC00] text-black font-extrabold text-xs hover:bg-[#e6b800] transition-all cursor-pointer">Send</button>
                </div>
            </div>
        </div>
    </div>
    

    <script>
        function showInvestigation() {
        const landing = document.querySelector('main');
        const footer = document.querySelector('footer');
        const investigation = document.getElementById('view-new-investigation');

        if (!investigation) {
            console.error('Screen 2 not found: view-new-investigation');
            return;
        }

        landing.classList.add('hidden');
        footer.classList.add('hidden');
        investigation.classList.remove('hidden');
    }
    function switchView(viewName) {
    const landing = document.querySelector('main');
    const footer = document.querySelector('footer');
    const investigation = document.getElementById('view-new-investigation');
    const cases = document.getElementById('view-cases');

    const showLanding = viewName === 'landing';
    const showInvestigation = viewName === 'new-investigation';
    const showCases = viewName === 'cases';

    if (landing) {
        landing.style.display = showLanding ? '' : 'none';
        landing.classList.toggle('hidden', !showLanding);
    }

    if (footer) {
        footer.style.display = showLanding ? '' : 'none';
        footer.classList.toggle('hidden', !showLanding);
    }

    if (investigation) {
        investigation.classList.toggle('hidden', !showInvestigation);
        investigation.style.display = showInvestigation ? '' : 'none';
    }

    if (cases) {
        cases.classList.toggle('hidden', !showCases);
        cases.style.display = showCases ? '' : 'none';
    }

    // If the React investigation overlay is open, close it before showing
    // Home, DMs, or Cases. Keep the clicked route as the active view.
    const workspaceHost = document.getElementById('veyra-react-workspace-host');
    if (!showInvestigation && workspaceHost) {
        workspaceHost.classList.add('hidden');
        workspaceHost.style.display = 'none';
        document.documentElement.classList.remove('veyra-investigation-open');
        document.body.classList.remove('veyra-investigation-open');
        window.dispatchEvent(new CustomEvent('veyra:workspace-closed'));
    }
}


        function loadCasesList() {
            const tbody = document.getElementById('cases-table-body');
            if (!tbody) return;

            tbody.innerHTML = '';

            if (savedCasesDB.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="5" class="py-6 text-center text-slate-500 italic">
                            No cases yet. Run an investigation to create one.
                        </td>
                    </tr>`;
                return;
            }

            savedCasesDB.forEach(c => {
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-white/5 cursor-pointer';

                const values = [
                    c.id,
                    `${c.scenario} (${c.sender})`,
                    c.status,
                    c.created
                ];

                values.forEach(value => {
                    const td = document.createElement('td');
                    td.className = 'py-2.5 px-3';
                    td.textContent = value ?? '';
                    tr.appendChild(td);
                });

                const action = document.createElement('td');
                action.className = 'py-2.5 px-3 text-right';

                const button = document.createElement('button');
                button.textContent = 'Open Agent Q&A →';
                button.className = 'text-[#FFCC00] cursor-pointer';
                button.onclick = event => {
                    event.stopPropagation();
                    selectCaseForAgent(c.id);
                };

                action.appendChild(button);
                tr.appendChild(action);
                tr.onclick = () => selectCaseForAgent(c.id);
                tbody.appendChild(tr);
            });
        }

function selectCaseForAgent(caseId) {
    selectedAgentCase = savedCasesDB.find(c => c.id === caseId);

    const badge = document.getElementById('active-agent-case-id');
    const messages = document.getElementById('agent-chat-messages');

    if (!selectedAgentCase || !badge || !messages) return;

    badge.textContent = selectedAgentCase.id + ' ACTIVE';
    messages.textContent =
        `Case loaded: ${selectedAgentCase.id}. ` +
        'Ask about the message, sender, classification, or evidence.';
}

function sendAgentChatMessage() {
    const input = document.getElementById('agent-chat-input');
    const messages = document.getElementById('agent-chat-messages');

    if (!input || !messages) return;

    const question = input.value.trim();
    if (!question) return;

    if (!selectedAgentCase) {
        alert('Please select a case from the table first.');
        return;
    }

    const userMessage = document.createElement('p');
    userMessage.textContent = 'You: ' + question;
    userMessage.className = 'p-2 rounded-xl bg-[#FFCC00]/10 text-white';
    messages.appendChild(userMessage);

    const q = question.toLowerCase();
    let answer;

    if (q.includes('why') || q.includes('flagged')) {
        answer = selectedAgentCase.explanation;
    } else if (q.includes('sender') || q.includes('account')) {
        answer = 'Sender: ' + selectedAgentCase.sender;
    } else if (q.includes('status') || q.includes('classification')) {
        answer = 'Classification: ' + selectedAgentCase.status;
    } else {
        answer =
            `Case ${selectedAgentCase.id}: ` +
            `${selectedAgentCase.scenario}. Message: ` +
            selectedAgentCase.message;
    }

    const reply = document.createElement('p');
    reply.textContent = 'Veyra: ' + answer;
    reply.className =
        'p-2 rounded-xl bg-classifiedGray text-slate-200';
    messages.appendChild(reply);

    input.value = '';
    messages.scrollTop = messages.scrollHeight;
}

        // --- Realistic Instagram DM Conversations Database ---
        let conversationsDB = [
            {
                id: "conv_1",
                username: "@emma_watson_99",
                name: "Emma Watson",
                avatar: "EM",
                verified: false,
                unread: false,
                isNew: false,
                lastTime: "Yesterday",
                investigationStatus: null,
                messages: [
                    { id: "m1", sender: "them", text: "Hey! Are we meeting this evening for coffee?", time: "4:14 PM" },
                    { id: "m2", sender: "me", text: "Hi Emma! Yes, let's meet at 6 PM.", time: "4:20 PM" }
                ]
            },
            {
                id: "conv_2",
                username: "@global_apex_gifts",
                name: "Global Apex Rewards",
                avatar: "GA",
                verified: true,
                unread: false,
                isNew: false,
                lastTime: "2h ago",
                investigationStatus: null,
                messages: [
                    { id: "m20", sender: "them", text: "Congratulations! Claim your $5000 reward at https://secure-bonus-claim.io", time: "2:14 PM" }
                ]
            },
            {
                id: "conv_3",
                username: "@support_fintech_guard",
                name: "Security Support",
                avatar: "SF",
                verified: true,
                unread: false,
                isNew: false,
                lastTime: "1h ago",
                investigationStatus: null,
                messages: [
                    { id: "m30", sender: "them", text: "Urgent: Verify your identity at https://verify-login-auth.com to restore access.", time: "1:58 PM" }
                ]
            }
        ];

        let activeConversationId = null;
        let selectedMessageForInvestigation = null;
        let activeInvestigationCase = null;
        let savedCasesDB = [];

        // --- Inbox Renderer ---
        function renderInbox() {
            const listEl = document.getElementById('phone-conversations-list');
            listEl.innerHTML = '';

            conversationsDB.forEach(conv => {
                const lastMsgObj = conv.messages[conv.messages.length - 1];
                const lastMsg = lastMsgObj ? (lastMsgObj.sender === 'me' ? 'You: ' + lastMsgObj.text : lastMsgObj.text) : '';
                const div = document.createElement('div');
                
                let rowBgClass = "hover:bg-white/5";
                if (conv.isNew) {
                    rowBgClass = "bg-[#FFCC00]/10 border-l-4 border-[#FFCC00] hover:bg-[#FFCC00]/15";
                }

                div.className = `flex items-center justify-between px-3.5 py-2 transition-colors cursor-pointer select-none ${rowBgClass}`;
                div.onclick = () => openChat(conv.id);

                let statusBadgeHtml = '';
                if (conv.investigationStatus) {
                    statusBadgeHtml = `<span class="text-[8px] mono bg-[#FFCC00]/20 text-[#FFCC00] px-1.5 py-0.5 rounded ml-1.5 font-bold">${conv.investigationStatus}</span>`;
                }

                div.innerHTML = `
                    <div class="flex items-center space-x-2.5 min-w-0">
                        <div class="w-9 h-9 rounded-full bg-classifiedGray border border-white/10 flex items-center justify-center text-[#FFCC00] font-bold text-xs shrink-0 relative">
                            ${conv.avatar}
                            ${conv.unread ? '<span class="absolute top-0 right-0 w-2.5 h-2.5 bg-[#FFCC00] border-2 border-obsidian rounded-full"></span>' : ''}
                        </div>
                        <div class="min-w-0">
                            <div class="flex items-center space-x-1">
                                <span class="text-white font-bold text-xs truncate">${conv.name}</span>
                                ${conv.verified ? '<span class="text-sky-400 text-[9px]">✔</span>' : ''}
                                ${conv.isNew ? '<span class="text-[7px] mono bg-[#FFCC00] text-black px-1.5 py-0.2 rounded font-extrabold uppercase animate-pulse">NEW</span>' : ''}
                                ${statusBadgeHtml}
                            </div>
                            <p class="text-slate-400 text-[10px] truncate mt-0.5 ${conv.unread ? 'text-white font-semibold' : ''}">${escapeHtml(lastMsg)}</p>
                        </div>
                    </div>
                    <div class="text-[9px] text-slate-500 shrink-0 ml-2">${conv.lastTime}</div>
                `;
                listEl.appendChild(div);
            });

            document.getElementById('phone-inbox-view').classList.remove('hidden');
            document.getElementById('phone-chat-view').classList.add('hidden');
        }


        // Render the three default conversations when the page first loads.
        function initializeInboxOnce() {
            renderInbox();
        }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", initializeInboxOnce, { once: true });
        } else {
            initializeInboxOnce();
        }

        function openChat(convId) {
            activeConversationId = convId;
            const conv = conversationsDB.find(c => c.id === convId);
            if (!conv) return;

            conv.unread = false;
            conv.isNew = false; // Mark as read when opened

            document.getElementById('active-chat-avatar').textContent = conv.avatar;
            document.getElementById('active-chat-username').textContent = conv.username;
            document.getElementById('active-chat-verified').style.display = conv.verified ? 'inline' : 'none';

            renderChatMessages();

            document.getElementById('phone-inbox-view').classList.add('hidden');
            document.getElementById('phone-chat-view').classList.remove('hidden');
            clearSelectedMessage();
        }

        function renderChatMessages() {
            const conv = conversationsDB.find(c => c.id === activeConversationId);
            if (!conv) return;

            const messagesBody = document.getElementById('active-chat-messages');
            messagesBody.innerHTML = '';

            conv.messages.forEach(msg => {
                const isThem = msg.sender === 'them';
                const msgDiv = document.createElement('div');
                msgDiv.className = `flex flex-col space-y-1 ${isThem ? 'items-start' : 'items-end'}`;
                
                let formattedText = escapeHtml(msg.text);
                const urlRegex = /(https?:\/\/[^\s]+)/g;
                const urls = msg.text.match(urlRegex) || [];
                urls.forEach(u => {
                    formattedText = formattedText.replace(u, `<a href="#" class="text-[#FFCC00] underline font-mono">${u}</a>`);
                });

                msgDiv.innerHTML = `
                    <div onclick="selectMessage('${msg.id}', '${conv.id}')" class="p-2.5 rounded-xl ${isThem ? 'bg-classifiedGray border border-white/10 text-white' : 'bg-[#FFCC00] text-black font-medium'} text-[11px] max-w-[85%] space-y-1 cursor-pointer hover:border-[#FFCC00] transition-all shadow-md relative group">
                        <p>${formattedText}</p>
                        <div class="flex items-center justify-between text-[8px] opacity-75 pt-1 border-t border-white/10">
                            <span>${msg.time}</span>
                            <span class="text-[#FFCC00] opacity-0 group-hover:opacity-100 font-bold mono">🔍 Click to Investigate</span>
                        </div>
                    </div>
                `;
                messagesBody.appendChild(msgDiv);
            });

            messagesBody.scrollTop = messagesBody.scrollHeight;
        }

        function backToInbox() {
            renderInbox();
        }

        function selectMessage(msgId, convId) {
            const conv = conversationsDB.find(c => c.id === convId);
            if (!conv) return;
            const msg = conv.messages.find(m => m.id === msgId);
            if (!msg) return;

            selectedMessageForInvestigation = {
                conv: conv,
                message: msg
            };

            const actionBar = document.getElementById('selected-message-action-bar');
            const previewText = document.getElementById('selected-msg-preview-text');
            actionBar.classList.remove('hidden');
            previewText.textContent = `"${msg.text}" from ${msg.sender === 'me' ? 'You' : conv.username}`;
        }

        function clearSelectedMessage() {
            selectedMessageForInvestigation = null;
            document.getElementById('selected-message-action-bar').classList.add('hidden');
        }

        // --- Interactive Message Sending ---
        function handleChatInputKeydown(event) {
            if (event.key === 'Enter' && !event.shiftKey) {
                event.preventDefault();
                sendUserChatMessage();
            }
        }

        function sendUserChatMessage() {
            const input = document.getElementById('chat-message-input');
            const text = input.value.trim();
            if (!text || !activeConversationId) return;

            const conv = conversationsDB.find(c => c.id === activeConversationId);
            if (!conv) return;

            const newMsg = {
                id: "msg_user_" + Date.now(),
                sender: "me",
                text: text,
                time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
            };

            conv.messages.push(newMsg);
            conv.lastTime = "Just now";
            input.value = '';

            renderChatMessages();
            clearSelectedMessage();
        }

        // --- Simulate an incoming message from an existing FalkorDB account ---
        async function triggerSimulateNewDm() {
            const select = document.getElementById('modal-scenario-select');
            const val = select ? select.value : 'normal_friend';

            const templates = {
                normal_friend: [
                    "Hey! Are we still meeting for coffee at 5?",
                    "I shared the project notes with you. Let me know if you need anything.",
                    "Made it home safely. Thanks for today!",
                    "Are you free this weekend? Let's catch up."
                ],
                suspicious_friend: [
                    "Urgent, can you send me money right now? I'll explain later.",
                    "I am locked out. Please send the verification code you just received.",
                    "Can you pay this processing fee for me immediately? Please don't call."
                ],
                hacked_friend: [
                    "Is this you in this video? https://demo-checkout.test/watch",
                    "Please sign in here to see the photos I sent: https://account-check.demo.invalid/login",
                    "I need you to check this link quickly: https://verify-session.demo.invalid/confirm"
                ],
                fake_business: [
                    "Congratulations! Claim your exclusive reward now: https://brand-rewards.demo.invalid/claim",
                    "Your order has a refund waiting. Confirm your payment details: https://shop-refund.demo.invalid/verify",
                    "You have been selected for a free gift. Pay the delivery fee: https://gift-delivery.demo.invalid/fee"
                ],
                verification_scam: [
                    "Your account will be suspended today. Verify your password now: https://account-check.demo.invalid/secure",
                    "Your badge is ready. Submit your login and verification code: https://verified-profile.demo.invalid/claim",
                    "Security alert: confirm your account immediately: https://identity-review.demo.invalid/confirm"
                ],
                investment_scam: [
                    "Invest ₹5,000 today and get guaranteed returns tomorrow. Send funds here: https://fast-profit.demo.invalid/invest",
                    "You've won a crypto giveaway! Send a small deposit to receive 10x back: https://crypto-reward.demo.invalid/claim",
                    "Limited-time investment offer. Guaranteed profit with no risk: https://daily-returns.demo.invalid/join"
                ]
            };

            const button = document.querySelector(
                '[onclick="triggerSimulateNewDm()"]'
            );
            if (button) {
                button.disabled = true;
                button.dataset.originalText = button.textContent;
                button.textContent = "Loading real accounts...";
            }

            try {
                const response = await fetch('/api/accounts?limit=500&offset=500', {
                    cache: 'no-store'
                });
                if (!response.ok) {
                    throw new Error(`Account API returned HTTP ${response.status}`);
                }

                const payload = await response.json();
                const accounts = Array.isArray(payload.accounts)
                    ? payload.accounts.filter(a => a && a.id && a.username)
                    : [];

                if (!accounts.length) {
                    throw new Error("FalkorDB returned no usable accounts.");
                }

                // Always use the intended synthetic sender for each scenario.
                // Never randomly assign a suspicious message to an unrelated account.
                const scenarioAccounts = {
                    normal_friend: "acct_friend_001",
                    suspicious_friend: "acct_friend_002",
                    hacked_friend: "acct_friend_002",
                    fake_business: "acct_business_001",
                    verification_scam: "acct_unknown_001",
                    investment_scam: "acct_brand_001"
                };

                const expectedAccountId =
                    scenarioAccounts[val] || scenarioAccounts.normal_friend;

                const account = accounts.find(
                    a => String(a.id) === expectedAccountId
                );

                if (!account) {
                    throw new Error(
                        `Required demo account ${expectedAccountId} was not returned by /api/accounts. ` +
                        "Check that the demo population has been seeded."
                    );
                }

                const username = String(account.username).replace(/^@/, '');
                const displayName = String(
                    account.display_name || account.name || username
                );
                const choices = templates[val] || templates.normal_friend;
                const messageText = choices[
                    Math.floor(Math.random() * choices.length)
                ];


                // Submit this exact sender/message to the real investigation API.
                const analysisResponse = await fetch('/api/messages/analyze', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        message: messageText,
                        sender_account_id: String(account.id),
                        sender_username: username,
                        sender_display_name: displayName,
                        scenario_id: `demo_${val}`,
                        source: 'dm_simulator'
                    })
                });

                if (!analysisResponse.ok) {
                    const detail = await analysisResponse.text();
                    throw new Error(
                        `Message analysis API returned HTTP ${analysisResponse.status}: ${detail}`
                    );
                }

                const analysisResult = await analysisResponse.json();
                const caseId = analysisResult.case_id
                    || analysisResult.case?.id
                    || analysisResult.id
                    || null;

                const now = Date.now();

                const newConv = {
                    id: `conv_${account.id}_${now}`,
                    accountId: String(account.id),
                    username: `@${username}`,
                    name: displayName,
                    avatar: displayName.slice(0, 2).toUpperCase(),
                    verified: account.verified === true,
                    unread: true,
                    isNew: true,
                    lastTime: "Just now",
                    investigationStatus: analysisResult.status || "investigating",
                    caseId: caseId,
                    messages: [{
                        id: `msg_${account.id}_${now}`,
                        sender: "them",
                        text: messageText,
                        time: "Just now",
                        caseId: caseId,
                        investigationStatus: analysisResult.status || "investigating"
                    }]
                };

                conversationsDB.unshift(newConv);
                renderInbox();

                const notif = document.createElement('div');
                notif.className =
                    "fixed bottom-6 right-6 z-50 bg-cardbg border border-[#FFCC00] " +
                    "text-white px-3.5 py-2.5 rounded-xl shadow-lg text-xs";
                notif.textContent =
                    `New simulated DM from ${newConv.name} (${newConv.username})`;
                document.body.appendChild(notif);
                setTimeout(() => notif.remove(), 3000);

                console.info("[VEYRA SIMULATOR] Existing graph account selected", {
                    accountId: account.id,
                    username: account.username,
                    messageType: val
                });
            } catch (error) {
                console.error("[VEYRA SIMULATOR] Could not create DM:", error);
                alert(
                    "Could not load accounts from FalkorDB. Check that the backend is running."
                );
            } finally {
                if (button) {
                    button.disabled = false;
                    button.textContent = button.dataset.originalText || "Simulate New DM";
                }
            }
        }




        
            function escapeHtml(value) {
                return String(value ?? '').replace(/[&<>"']/g, function (char) {
                    const entities = {
                        '&': '&amp;',
                        '<': '&lt;',
                        '>': '&gt;',
                        '"': '&quot;',
                        "'": '&#39;'
                    };
                    return entities[char];
                });
            }

        const container = document.getElementById('graph-container');
        const scene = new THREE.Scene();

        const camera = new THREE.PerspectiveCamera(50, container.clientWidth / container.clientHeight, 0.1, 1000);
        camera.position.set(0, 0, 8.2);

        const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        renderer.setSize(container.clientWidth, container.clientHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        container.appendChild(renderer.domElement);

        const ambientLight = new THREE.AmbientLight(0xffffff, 3.5);
        scene.add(ambientLight);

        const pointLight1 = new THREE.PointLight(0xFFD700, 18.0, 150);
        pointLight1.position.set(6, 6, 6);
        scene.add(pointLight1);

        const pointLight2 = new THREE.PointLight(0x00FFFF, 12.0, 120);
        pointLight2.position.set(-6, -6, 6);
        scene.add(pointLight2);

        const particleCount = 200;
        const particleGeometry = new THREE.BufferGeometry();
        const particlePositions = new Float32Array(particleCount * 3);
        for(let i = 0; i < particleCount * 3; i++) {
            particlePositions[i] = (Math.random() - 0.5) * 24;
        }
        particleGeometry.setAttribute('position', new THREE.BufferAttribute(particlePositions, 3));
        const particleMaterial = new THREE.PointsMaterial({ color: 0xFFD700, size: 0.08, transparent: true, opacity: 0.4 });
        const particleSystem = new THREE.Points(particleGeometry, particleMaterial);
        scene.add(particleSystem);

        const graphGroup = new THREE.Group();
        scene.add(graphGroup);

        let nodeMeshes = {};
        let nodeObjects = [];
        let nodeDataMap = {};
        let edgeLines = [];
        let edgePulses = [];
      const lineMaterial = new THREE.LineBasicMaterial({
     color: 0xFF8C00,
     transparent: false,
     opacity: 1,
     linewidth: 1
});

        // Sophisticated, visible golden hues (avoiding neon yellow)
        function getNodeStyle(type) {
            switch(type?.toLowerCase()) {
                case 'account': return { color: 0xE5B80B, roughness: 0.25, metalness: 0.8 };
                case 'domain': return { color: 0xE63946, roughness: 0.25, metalness: 0.8 };
                case 'url': return { color: 0xF4A261, roughness: 0.25, metalness: 0.8 };
                case 'brand': return { color: 0x2A9D8F, roughness: 0.25, metalness: 0.8 };
                case 'report': return { color: 0xE9C46A, roughness: 0.25, metalness: 0.8 };
                case 'evidence': return { color: 0x264653, roughness: 0.25, metalness: 0.8 };
                default: return { color: 0xD4AF37, roughness: 0.25, metalness: 0.8 };
            }
        }

        const VEYRA_GRAPH_CACHE_KEY = "veyra.graph.cache.v2";
        const VEYRA_GRAPH_CACHE_TTL = 60 * 1000;

        function normalizeVeyraGraph(raw) {
            const nodes = (raw.nodes || []).map(node => {
                const properties = node.properties || {};
                const labels = node.labels || [];
                return {
                    id: String(node.node_id ?? properties.id),
                    type: labels.find(label => label !== "Entity") || labels[0] || "Node",
                    name: properties.name || properties.username ||
                          properties.display_name || properties.id ||
                          String(node.node_id),
                    properties,
                    labels
                };
            });

            const edges = (raw.edges || []).map((edge, index) => ({
                id: `${edge.from_id}-${edge.relationship}-${edge.to_id}-${index}`,
                source: String(edge.from_id),
                target: String(edge.to_id),
                type: edge.relationship,
                properties: {
                    from: edge.from || {},
                    to: edge.to || {}
                }
            }));

            return { nodes, edges };
        }

        function readVeyraGraphCache() {
            try {
                const item = JSON.parse(sessionStorage.getItem(VEYRA_GRAPH_CACHE_KEY) || "null");
                if (!item || !item.savedAt || !item.graph) return null;
                return item;
            } catch (_) {
                return null;
            }
        }

        function saveVeyraGraphCache(graph) {
            try {
                sessionStorage.setItem(VEYRA_GRAPH_CACHE_KEY, JSON.stringify({
                    savedAt: Date.now(),
                    graph
                }));
            } catch (err) {
                console.warn("Graph cache unavailable; continuing normally.", err);
            }
        }

        async function loadGraphData() {
            const status = document.getElementById("db-status");
            const cached = readVeyraGraphCache();

            // Display cached data immediately on repeat visits.
            if (cached && cached.graph.nodes?.length) {
                renderGraph(cached.graph);
                if (status) {
                    status.innerText =
                        `FALKORDB: ${cached.graph.nodes.length} NODES · ` +
                        `${cached.graph.edges.length} RELATIONSHIPS · CACHED`;
                    status.title = "Showing cached graph data while checking for updates";
                }
                if (Date.now() - cached.savedAt < VEYRA_GRAPH_CACHE_TTL) {
                    return;
                }
            }

            try {
                const response = await fetch("/api/graph", { cache: "no-cache" });
                if (!response.ok) throw new Error(`Graph API returned HTTP ${response.status}`);

                const raw = await response.json();
                if (!Array.isArray(raw.nodes) || !raw.nodes.length) {
                    throw new Error("FalkorDB returned no nodes");
                }

                const graph = normalizeVeyraGraph(raw);
                saveVeyraGraphCache(graph);

                // Don't rebuild an identical-sized graph if the cache already rendered it.
                const sameCounts = cached &&
                    cached.graph.nodes.length === graph.nodes.length &&
                    cached.graph.edges.length === graph.edges.length;

                if (!sameCounts || !cached) renderGraph(graph);

                if (status) {
                    status.innerText =
                        `FALKORDB: ${raw.total_node_count ?? graph.nodes.length} NODES · ` +
                        `${raw.total_relationship_count ?? graph.edges.length} RELATIONSHIPS`;
                    status.title = "Graph data loaded from the FalkorDB API";
                }
            } catch (err) {
                console.error("Failed to load FalkorDB graph:", err);
                if (!cached && status) status.innerText = "FALKORDB: CONNECTION ERROR";
                // Keep an existing cached graph visible if the API is temporarily unavailable.
                if (!cached) renderGraph({ nodes: [], edges: [] });
            }
        }

        function renderGraph(graphData) {
            nodeObjects.forEach(obj => graphGroup.remove(obj));
            edgeLines.forEach(line => graphGroup.remove(line));
            edgePulses.forEach(pulse => graphGroup.remove(pulse));
            nodeMeshes = {};
            nodeObjects = [];
            nodeDataMap = {};
            edgeLines = [];
            edgePulses = [];

            const sharedNodeGeometry = new THREE.SphereGeometry(0.085, 8, 8);

            graphData.nodes.forEach((nodeData, idx) => {
                // Normalize real FalkorDB nodes and fallback nodes
            nodeData.properties = nodeData.properties ?? {};

            if (!nodeData.id) {
                nodeData.id =
                    nodeData.properties.id ??
                    nodeData.properties.scenario_id ??
                    nodeData.properties.account_id ??
                    nodeData.properties.url ??
                    nodeData.properties.name;
            }

            if (!nodeData.type) {
                nodeData.type =
                    nodeData.labels?.find(label => label !== "Entity") ??
                    nodeData.labels?.[0] ??
                    "Node";
            }

            if (!nodeData.id) {
                console.warn("Skipping node without a usable ID:", nodeData);
                return;
            }

            const styling = getNodeStyle(nodeData.type);
                nodeData.color = styling.color;
                
                if (!nodeData.position || nodeData.position.length < 3) {
                    const phi = Math.acos(-1 + (2 * idx) / graphData.nodes.length);
                    const theta = Math.sqrt(graphData.nodes.length * Math.PI) * phi;
                    nodeData.position = [
                        2.2 * Math.cos(theta) * Math.sin(phi),
                        2.2 * Math.sin(theta) * Math.sin(phi),
                        2.2 * Math.cos(phi)
                    ];
                }
                nodeData.velocity = [0, 0, 0];
                nodeDataMap[nodeData.id] = nodeData;

                // Smaller, refined 3D spherical nodes (radius 0.26 for crisp look)
                const geometry = sharedNodeGeometry;
                const material = new THREE.MeshStandardMaterial({
                    color: nodeData.color,
                    emissive: nodeData.color,
                    emissiveIntensity: 0.45,
                    roughness: styling.roughness,
                    metalness: styling.metalness
                });
                const mesh = new THREE.Mesh(geometry, material);
                mesh.position.set(...nodeData.position);
                mesh.userData = { id: nodeData.id, type: 'node', data: nodeData };

                graphGroup.add(mesh);
                nodeMeshes[nodeData.id] = mesh;
                nodeObjects.push(mesh);
            });

            graphData.edges.forEach((edgeData, index) => {
                if (index === 0) {
                console.log("FIRST EDGE:", edgeData);
                console.log("NODE IDs:", Object.keys(nodeDataMap).slice(0, 5));
            }
             const sourceId = edgeData.source ?? edgeData.from?.id;
             const targetId = edgeData.target ?? edgeData.to?.id;

             const sourceNode = nodeDataMap[sourceId];
             const targetNode = nodeDataMap[targetId];

                if (sourceNode && targetNode) {
                    const points = [
                        new THREE.Vector3(...sourceNode.position),
                        new THREE.Vector3(...targetNode.position)
                    ];
                    const geometry = new THREE.BufferGeometry().setFromPoints(points);
                    const line = new THREE.Line(geometry, lineMaterial);
                    line.userData = {
                        id: edgeData.id,
                        type: 'edge',
                        data: edgeData,
                        sourceId: String(sourceId),
                        targetId: String(targetId)
                    };
                    graphGroup.add(line);
                    edgeLines.push(line);

                    // Animate only every 12th edge to reduce GPU work.
                    if (index % 24 === 0) {
                    const pulseGeo = new THREE.SphereGeometry(0.05, 10, 10);
                    const pulseMat = new THREE.MeshBasicMaterial({ color: 0xFF8C00 });
                    const pulseMesh = new THREE.Mesh(pulseGeo, pulseMat);
                    pulseMesh.userData = {
                        sourceId: String(sourceId),
                        targetId: String(targetId),
                        progress: Math.random(),
                        speed: 0.004 + (index % 3) * 0.0015
                    };
                    graphGroup.add(pulseMesh);
                    edgePulses.push(pulseMesh);
                    }
                }
            });

            window.currentGraphData = graphData;
        }

        const raycaster = new THREE.Raycaster();
        const mouse = new THREE.Vector2();
        let draggedNode = null;
        let isRotatingScene = false;
        let previousMousePosition = { x: 0, y: 0 };
        const plane = new THREE.Plane();
        const planeIntersect = new THREE.Vector3();

        const tooltip = document.getElementById('graph-tooltip');
        const tooltipType = document.getElementById('tooltip-type');
        const tooltipId = document.getElementById('tooltip-id');
        const tooltipTitle = document.getElementById('tooltip-title');
        const tooltipDetails = document.getElementById('tooltip-details');

        container.addEventListener('mousedown', (event) => {
            const rect = renderer.domElement.getBoundingClientRect();
            mouse.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
            mouse.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;

            raycaster.setFromCamera(mouse, camera);
            const intersects = raycaster.intersectObjects(nodeObjects);

            if (intersects.length > 0) {
                draggedNode = intersects[0].object;
                plane.setFromNormalAndCoplanarPoint(camera.getWorldDirection(plane.normal).negate(), draggedNode.position);
                isRotatingScene = false;
            } else {
                isRotatingScene = true;
                previousMousePosition = { x: event.clientX, y: event.clientY };
            }
        });

        window.addEventListener('mousemove', (event) => {
            const rect = renderer.domElement.getBoundingClientRect();
            mouse.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
            mouse.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;

            raycaster.setFromCamera(mouse, camera);

            if (draggedNode) {
                raycaster.ray.intersectPlane(plane, planeIntersect);
                draggedNode.position.copy(planeIntersect);
                const nData = draggedNode.userData.data;
                nData.position = [draggedNode.position.x, draggedNode.position.y, draggedNode.position.z];
                nData.velocity = [0, 0, 0];
                document.body.style.cursor = 'grabbing';
                return;
            }

            if (isRotatingScene) {
                const deltaX = event.clientX - previousMousePosition.x;
                const deltaY = event.clientY - previousMousePosition.y;

                graphGroup.rotation.y += deltaX * 0.004;
                graphGroup.rotation.x += deltaY * 0.004;

                previousMousePosition = { x: event.clientX, y: event.clientY };
                document.body.style.cursor = 'grabbing';
                return;
            }

            const intersects = raycaster.intersectObjects(nodeObjects);
            if (intersects.length > 0) {
                const hoveredMesh = intersects[0].object;
                const node = hoveredMesh.userData.data;

                const connectedEdges = window.currentGraphData?.edges.filter(e => e.source === node.id || e.target === node.id) || [];

                tooltip.style.opacity = '1';
                tooltipType.innerText = `EVIDENCE TYPE: ${node.type || 'NODE'}`;
                tooltipId.innerText = `ID: ${node.id}`;
                tooltipTitle.innerText = node.name || node.title || node.id;
                
                let detailsHtml = '';
                if (node.properties) {
                    for (const [key, val] of Object.entries(node.properties)) {
                        detailsHtml += `<span class="text-[#FFCC00] font-bold">${key}</span>: ${val}  `;
                    }
                }
                detailsHtml += `<br><span class="text-[#FFCC00] font-bold">Connected Relationships</span>: ${connectedEdges.length}`;
                tooltipDetails.innerHTML = detailsHtml;

                document.body.style.cursor = 'pointer';
            } else {
                tooltip.style.opacity = '0';
                document.body.style.cursor = 'default';
            }
        });

        window.addEventListener('mouseup', () => {
            if (draggedNode) {
                const nData = draggedNode.userData.data;
                nData.velocity = [
                    -nData.position[0] * 0.04,
                    -nData.position[1] * 0.04,
                    -nData.position[2] * 0.04
                ];
                draggedNode = null;
            }
            isRotatingScene = false;
            document.body.style.cursor = 'default';
        });

        let clock = new THREE.Clock();
        let graphAnimationFrame = null;

        function animateGraph() {
            graphAnimationFrame = null;

            const graphContainer = document.getElementById('graph-container');
            if (!graphContainer || !graphContainer.isConnected ||
                graphContainer.getClientRects().length === 0 ||
                document.hidden) {
                return;
            }

            graphAnimationFrame = requestAnimationFrame(animateGraph);
            const elapsedTime = clock.getElapsedTime();

            if (!isRotatingScene && !draggedNode) {
                // Smooth, slow rotation
                graphGroup.rotation.y += 0.0005;
                graphGroup.rotation.x = Math.sin(elapsedTime * 0.25) * 0.03;
            }

            const positions = particleGeometry.attributes.position.array;
            for(let i = 1; i < positions.length; i += 6) {
                positions[i] += 0.0012;
                if(positions[i] > 12) positions[i] = -12;
            }
            particleGeometry.attributes.position.needsUpdate = true;

            if (window.currentGraphData && window.currentGraphData.nodes) {
                window.currentGraphData.nodes.forEach((nData, index) => {
                    const mesh = nodeMeshes[nData.id];
                    if (mesh && mesh !== draggedNode) {
                        nData.position[0] += nData.velocity[0];
                        nData.position[1] += nData.velocity[1];
                        nData.position[2] += nData.velocity[2];
                        nData.velocity[0] *= 0.92;
                        nData.velocity[1] *= 0.92;
                        nData.velocity[2] *= 0.92;
                        mesh.position.set(...nData.position);
                    }
                    if (mesh) {
                        const pulse = 0.5 + 0.2 * Math.sin(elapsedTime * 2.5 + index * 1.5);
                        mesh.material.emissiveIntensity = pulse;
                    }
                });
            }

            edgeLines.forEach(line => {
                const sNode = nodeDataMap[line.userData.sourceId];
                const tNode = nodeDataMap[line.userData.targetId];
                if (sNode && tNode) {
                    const positions = line.geometry.attributes.position.array;
                    positions[0] = sNode.position[0];
                    positions[1] = sNode.position[1];
                    positions[2] = sNode.position[2];
                    positions[3] = tNode.position[0];
                    positions[4] = tNode.position[1];
                    positions[5] = tNode.position[2];
                    line.geometry.attributes.position.needsUpdate = true;
                }
            });

            edgePulses.forEach(pulse => {
                const sNode = nodeDataMap[pulse.userData.sourceId];
                const tNode = nodeDataMap[pulse.userData.targetId];
                if (sNode && tNode) {
                    pulse.userData.progress += pulse.userData.speed;
                    if (pulse.userData.progress > 1) pulse.userData.progress = 0;
                    
                    const t = pulse.userData.progress;
                    pulse.position.set(
                        sNode.position[0] + (t * (tNode.position[0] - sNode.position[0])),
                        sNode.position[1] + (t * (tNode.position[1] - sNode.position[1])),
                        sNode.position[2] + (t * (tNode.position[2] - sNode.position[2]))
                    );
                }
            });

            renderer.render(scene, camera);
        }
        function resumeGraphAnimation() {
            if (graphAnimationFrame === null &&
                !document.hidden &&
                document.getElementById('graph-container')?.getClientRects().length) {
                animateGraph();
            }
        }

        document.addEventListener('visibilitychange', resumeGraphAnimation);

        const graphViewObserver = new MutationObserver(resumeGraphAnimation);
        const graphContainer = document.getElementById('graph-container');
        if (graphContainer) {
            graphViewObserver.observe(graphContainer, {
                attributes: true,
                attributeFilter: ['class', 'style']
            });
        }

        const viewObserver = new MutationObserver(resumeGraphAnimation);
        const landingMain = document.querySelector('main');
        if (landingMain) {
            viewObserver.observe(landingMain, {
                attributes: true,
                attributeFilter: ['class', 'style']
            });
        }

        resumeGraphAnimation();

        window.addEventListener('resize', () => {
            const width = container.clientWidth;
            const height = container.clientHeight;
            camera.aspect = width / height;
            camera.updateProjectionMatrix();
            renderer.setSize(width, height);
        });

        window.addEventListener('load', () => {
            loadGraphData();
        });


    
        // Header navigation: reuse the existing application view switcher.
        document.querySelectorAll('nav[aria-label="Main navigation"] [data-veyra-view]')
            .forEach(link => {
                link.addEventListener("click", event => {
                    const view = link.dataset.veyraView;
                    const viewMap = {
                        home: "landing",
                        dms: "new-investigation",
                        cases: "cases"
                    };

                    if (typeof window.switchView === "function") {
                        event.preventDefault();
                        window.switchView(viewMap[view]);
                        history.replaceState(null, "", "#" + view);
                    }
                });
            });

</script>

<script>
async function executeVeyraInvestigationOnSelected() {
    const selection = selectedMessageForInvestigation;

    const wrapper = document.getElementById("investigation-result-wrapper");
    const badge = document.getElementById("case-id-badge");
    const banner = document.getElementById("result-status-banner");
    const explanation = document.getElementById("result-explanation");

    if (!selection || !selection.message) {
        alert("Select a message first, bro.");
        return;
    }

    if (!wrapper || !badge || !banner || !explanation) {
        console.error("Veyra investigation result UI elements are missing.");
        alert("The investigation result panel could not be found.");
        return;
    }

    // Capture the selection now so later UI changes cannot change this run.
    const msg = selection.message;
    const messageText = typeof msg === "string"
        ? msg
        : (msg.text ?? msg.content ?? msg.body ?? msg.message ?? "");

    if (typeof messageText !== "string" || !messageText.trim()) {
        alert("Could not read the selected message text.");
        return;
    }

    const button = document.querySelector(
        'button[onclick="executeVeyraInvestigationOnSelected()"]'
    );

    if (button) {
        button.disabled = true;
        button.dataset.originalText = button.textContent;
        button.textContent = "Investigating...";
    }

    wrapper.classList.remove("hidden");
    badge.textContent = "Creating case...";
    banner.textContent = "INVESTIGATING";
    explanation.textContent =
        "Submitting the selected message to Veyra and checking connected evidence in FalkorDB...";

    try {
        const response = await fetch("/api/messages/analyze", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                message: messageText.trim(),
                source: "dm_simulator"
            })
        });

        const created = await response.json();

        if (!response.ok) {
            throw new Error(
                created.detail || `Case creation failed (${response.status})`
            );
        }

        if (!created.case_id) {
            throw new Error("The API response did not include a case ID.");
        }

        activeInvestigationCase = {
            id: created.case_id,
            case_id: created.case_id
        };

        badge.textContent = "CASE #" + created.case_id;
        banner.textContent = String(
            created.status || created.initial_status || "INVESTIGATING"
        ).replaceAll("_", " ").toUpperCase();

        explanation.textContent =
            created.assessment ||
            "The case was created. Waiting for the connected-evidence investigation...";

        // New cases are investigated in the background. Read the persisted
        // case until it reaches a terminal status or the polling limit.
        let current = created;
        const terminal = new Set([
            "completed",
            "needs_review",
            "investigation_failed"
        ]);

        for (let attempt = 0; attempt < 20; attempt++) {
            const status = String(current.status || "").toLowerCase();

            if (terminal.has(status)) break;

            await new Promise(resolve => setTimeout(resolve, 1500));

            const check = await fetch(
                "/api/cases/" + encodeURIComponent(created.case_id)
            );
            const latest = await check.json();

            if (!check.ok) {
                throw new Error(
                    latest.detail || `Case lookup failed (${check.status})`
                );
            }

            current = latest;

            banner.textContent =
                String(current.status || "investigating")
                    .replaceAll("_", " ")
                    .toUpperCase();

            explanation.textContent =
                current.assessment ||
                current.initial_assessment ||
                "Veyra is checking the available connected evidence...";
        }

        activeInvestigationCase = {
            id: created.case_id,
            case_id: created.case_id,
            status: current.status
        };

        const findings = Array.isArray(current.findings)
            ? current.findings
            : [];

        const details = findings.map((finding, index) => {
            const parts = [];

            if (finding.domain) parts.push("Domain: " + finding.domain);
            if (finding.connected_account_id) {
                parts.push("Connected account: " + finding.connected_account_id);
            }
            if (finding.report_id) parts.push("Report: " + finding.report_id);
            if (finding.message_id) parts.push("Message: " + finding.message_id);

            return `${index + 1}. ${parts.join(" | ") || "Evidence record found"}`;
        });

        const assessment =
            current.assessment ||
            current.initial_assessment ||
            "No assessment was returned by the API.";

        explanation.textContent = details.length
            ? assessment + "\n\nConnected evidence:\n" + details.join("\n")
            : assessment + "\n\nNo matching connected evidence was returned.";

        if (current.status === "investigation_failed") {
            explanation.textContent +=
                "\n\nInvestigation error: " +
                (current.error || "The backend reported a failure.");
        } else if (
            !terminal.has(String(current.status || "").toLowerCase())
        ) {
            explanation.textContent +=
                "\n\nThe investigation is still running. Reopen this case to check again.";
        }

        if (typeof savedCasesDB !== "undefined" &&
            Array.isArray(savedCasesDB)) {
            const existingIndex = savedCasesDB.findIndex(
                item => item.id === created.case_id
            );

            if (existingIndex >= 0) {
                savedCasesDB[existingIndex] = {
                    ...savedCasesDB[existingIndex],
                    ...activeInvestigationCase
                };
            } else {
                savedCasesDB.push(activeInvestigationCase);
            }
        }

    } catch (error) {
        console.error("Veyra investigation failed:", error);
        banner.textContent = "REQUEST FAILED";
        explanation.textContent =
            "Veyra could not complete the request: " +
            (error.message || String(error)) +
            "\n\nCheck that the backend is running and inspect its logs.";
    } finally {
        if (button) {
            button.disabled = false;
            button.textContent =
                button.dataset.originalText || "Investigate with Veyra";
        }
    }
}
</script>



<div id="veyra-react-workspace-host" style="display:none;position:fixed;top:88px;right:0;bottom:0;left:0;z-index:9990;background:#070709;overflow-y:auto;overflow-x:hidden;isolation:isolate">
  <div id="veyra-react-workspace-root"></div>
</div>
<script type="module" src="/src/workspace-entry.tsx"></script>
<script>
window.executeVeyraInvestigationOnSelected = function () {
  const selection = window.selectedMessageForInvestigation ||
                    selectedMessageForInvestigation;
  if (!selection || !selection.message) {
    alert("Select a message first.");
    return;
  }

  const message = typeof selection.message === "string"
    ? selection.message
    : (selection.message.text ||
       selection.message.content ||
       selection.message.body ||
       selection.message.message ||
       "");

  if (!message.trim()) {
    alert("The selected message has no readable text.");
    return;
  }

  if (typeof window.openVeyraWorkspace !== "function") {
    alert("Investigation workspace is still loading. Please try again.");
    return;
  }

  window.openVeyraWorkspace({
    text: message.trim(),
    simulatorMessageId: selection.message.id || null,
    conversationId: selection.conv?.id || null,
    senderUsername: selection.conv?.username || null,
    senderAccountId: selection.conv?.accountId || null,
    senderDisplayName: selection.conv?.name || null,
    senderUiVerified: selection.conv?.verified === true
  });
};
</script>

</body>
</html>