import React, { useState, useEffect, useRef } from 'react';

// Inline Icons for Cyber-Forensics UI
const CheckIcon = () => (
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="3" strokeLinecap="round" strokeLinejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
);

type WorkspaceContext = {
  suspectId?: string;
  targetUrl?: string;
};

type SimulatorMetadata = {
  simulatorMessageId?: string | null;
  conversationId?: string | null;
  senderUsername?: string | null;
  senderAccountId?: string | null;
  senderDisplayName?: string | null;
  senderUiVerified?: boolean;
  scenarioId?: string | null;
};

type WorkspaceNode = {
  id: string;
  type: string;
  name: string;
  color?: number;
  [key: string]: unknown;
};

type WorkspaceEdge = {
  source: string;
  target: string;
  label: string;
};

type WorkspaceCaseData = {
  caseId: string;
  confidence: string;
  risk: string;
  summary: string;
  entities: { type: string; name: string; risk: string }[];
  remediation: {
    action: string;
    reason: string;
    confidence: string;
  } | null;
  graphData: {
    nodes: WorkspaceNode[];
    edges: WorkspaceEdge[];
  };
};

declare global {
  interface Window {
    THREE?: any;
  }
}



export default function InvestigationWorkspace({
  initialMessage = null,
  initialContext = null,
  initialMetadata = null,
  onClose
}: {
  initialMessage?: string | null;
  initialContext?: WorkspaceContext | null;
  initialMetadata?: SimulatorMetadata | null;
  onClose?: () => void;
}) {
  // Mode A if triggered from DMs/messages, Mode B if opened directly from tab
  const entryMode = initialMessage ? 'A' : 'B';
  
  const [investigationQuery, setInvestigationQuery] = useState(
    initialMessage || ''
  );
  const [suspectId, setSuspectId] = useState(initialContext?.suspectId || '');
  const [targetUrl, setTargetUrl] = useState(initialContext?.targetUrl || '');
  
  const [workflowState, setWorkflowState] = useState('idle'); // idle, running, completed, failed
  const [activeStage, setActiveStage] = useState(0);
  const [caseData, setCaseData] = useState<WorkspaceCaseData | null>(null);
  const [, setGraphReady] = useState(false);
  const [, setSelectedNode] = useState<WorkspaceNode | null>(null);
  const [showFalkorView, setShowFalkorView] = useState(false);
  const [queryEvents, setQueryEvents] = useState<any[]>([]);
  const [agentAssessment, setAgentAssessment] = useState<{
    status: "loading" | "ready" | "error";
    answer: string;
    error?: string;
  } | null>(null);
  const assessmentRequestedFor = useRef<string | null>(null);

  // VEYRA_AGENT_ASSESSMENT_CARD
  // The backend loads saved evidence and persists the complete assessment.
  const generateAssessment = async (caseId: string) => {
    setAgentAssessment({
      status: "loading",
      answer: "VEYRA is reviewing the saved investigation evidence...",
    });

    try {
      const response = await fetch(
        `/api/cases/${encodeURIComponent(caseId)}/assessment`,
        { method: "POST" }
      );

      const raw = await response.text();
      let payload: any = {};
      try {
        payload = raw ? JSON.parse(raw) : {};
      } catch {
        throw new Error(`Agent returned a non-JSON response (HTTP ${response.status}).`);
      }

      if (!response.ok) {
        throw new Error(
          typeof payload.detail === "string"
            ? payload.detail
            : `Agent request failed (HTTP ${response.status}).`
        );
      }

      if (typeof payload.answer !== "string" || !payload.answer.trim()) {
        throw new Error("The agent returned an empty assessment.");
      }

      setAgentAssessment({ status: "ready", answer: payload.answer });
    } catch (error) {
      setAgentAssessment({
        status: "error",
        answer: "",
        error: error instanceof Error
          ? error.message
          : "Could not generate the agent assessment.",
      });
    }
  };

  useEffect(() => {
    if (!caseData || workflowState !== "completed") return;
    if (assessmentRequestedFor.current === caseData.caseId) return;

    assessmentRequestedFor.current = caseData.caseId;
    void generateAssessment(caseData.caseId);
  }, [caseData, workflowState]);


  // Execute a read-only query against FalkorDB before opening its browser.
  const openInFalkorDB = async () => {
    const currentNodes = caseData?.graphData?.nodes ?? [];
    const ids = [...new Set(
      currentNodes
        .map(node => String(
          (node.properties as Record<string, unknown> | undefined)?.id
          ?? node.id
          ?? ""
        ))
        .filter(id => id && !id.startsWith("observed:"))
    )];

    if (!ids.length) {
      alert("No stored FalkorDB entity IDs are available for this investigation.");
      return;
    }

    try {
      const response = await fetch("/api/graph/investigation", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ entity_ids: ids })
      });

      const result = await response.json();
      if (!response.ok) {
        throw new Error(result.detail || "FalkorDB query failed.");
      }

      const graphNodes = (result.nodes || []).map((item: any) => {
        const props = item.properties || {};
        const labels: string[] = item.labels || [];
        const type = labels.find((label: string) => label !== "Entity")
          || props.entity_type || "Entity";

        return {
          id: String(item.id),
          type,
          name: String(
            props.name || props.display_name || props.username || props.id
          ),
          color: type === "Report" ? 0xfb7185
            : type === "Domain" || type === "URL" ? 0xc084fc
            : type === "Evidence" ? 0x34d399
            : type === "Account" ? 0x60a5fa
            : 0xfacc15,
          properties: props
        };
      });

      const graphEdges = (result.edges || []).map((edge: any) => ({
        source: String(edge.source),
        target: String(edge.target),
        type: String(edge.relationship || "CONNECTED_TO"),
        label: String(edge.relationship || "CONNECTED_TO")
      }));

      if (!graphNodes.length) {
        throw new Error("FalkorDB returned no matching graph nodes.");
      }

      setCaseData(previous => previous ? {
        ...previous,
        graphData: { nodes: graphNodes, edges: graphEdges }
      } : previous);

      setShowFalkorView(true);

      const host = window.location.hostname;
      const suffix = ".app.github.dev";
      const portSeparator = host.lastIndexOf("-");
      const falkorHost =
        host.endsWith(suffix) && portSeparator > 0
          ? `${host.slice(0, portSeparator)}-3000${suffix}`
          : null;

      if (!falkorHost) {
        alert(
          `FalkorDB query succeeded (${result.node_count} nodes, ${result.edge_count} links), but the forwarded browser URL could not be determined. Open port 3000 in Codespaces.`
        );
        return;
      }

      const literals = ids.map(id => JSON.stringify(id)).join(", ");
      const query =
        `MATCH (n:Entity) WHERE n.id IN [${literals}] ` +
        `OPTIONAL MATCH (n)-[r]-(m:Entity) ` +
        `WHERE m.id IN [${literals}] RETURN n, r, m LIMIT 100`;

      const url =
        `https://${falkorHost}/graph?graph=${encodeURIComponent("VEYRA")}` +
        `&query=${encodeURIComponent(query)}`;

      window.open(url, "_blank", "noopener,noreferrer");
    } catch (error) {
      console.error("Failed to load the FalkorDB investigation graph:", error);
      alert(
        error instanceof Error
          ? `Could not load the FalkorDB graph: ${error.message}`
          : "Could not load the FalkorDB graph."
      );
    }
  };


  const graphContainerRef = useRef<HTMLDivElement | null>(null);

  const stages = [
    { id: 1, name: 'Create Case' },
    { id: 2, name: 'Extract Entities' },
    { id: 3, name: 'Query FalkorDB' },
    { id: 4, name: 'Analyze Connections' },
    { id: 5, name: 'Collect Evidence' },
    { id: 6, name: 'Generate Summary' }
  ];

  // If Mode A (triggered from DMs), start execution immediately
  useEffect(() => {
    if (entryMode === 'A' && workflowState === 'idle') {
      startInvestigation();
    }
  }, [entryMode]);

  const startInvestigation = async () => {
    if (workflowState === 'running') return;

    const message = investigationQuery.trim();
    if (!message) {
      setWorkflowState('failed');
      return;
    }

    setQueryEvents([]);
    setWorkflowState('running');
    setActiveStage(1);
    setGraphReady(false);
    setSelectedNode(null);

    setCaseData({
      caseId: 'Creating case...',
      confidence: 'Not calculated',
      risk: 'Pending investigation',
      summary: 'Submitting the message to the Veyra investigation backend...',
      entities: [],
      remediation: null,
      graphData: { nodes: [], edges: [] }
    });

    try {
      const submitResponse = await fetch('/api/messages/analyze', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          message,
          simulator_message_id: initialMetadata?.simulatorMessageId ?? null,
          conversation_id: initialMetadata?.conversationId ?? null,
          sender_username: initialMetadata?.senderUsername ?? null,
          sender_account_id: initialMetadata?.senderAccountId ?? null,
          sender_display_name: initialMetadata?.senderDisplayName ?? null,
          scenario_id: initialMetadata?.scenarioId ?? null,
          // UI verification badges are not trusted identity evidence.
          source: initialMetadata ? 'dm_simulator' : 'investigation_workspace'
        })
      });

      if (!submitResponse.ok) {
        const body = await submitResponse.text();
        throw new Error(
          `Could not submit investigation (${submitResponse.status}): ${body}`
        );
      }

      const submitted = await submitResponse.json();
      console.log('[VEYRA DEBUG] Submit response:', submitted);
      const caseId = submitted.case_id;

      if (!caseId) {
        throw new Error('Backend response did not contain a case ID.');
      }

      setActiveStage(2);
      setCaseData(prev => prev ? {
        ...prev,
        caseId,
        summary: 'Case saved. Retrieving its persisted investigation status...'
      } : prev);

      // Poll the persisted case until the backend reaches a terminal state.
      const maxAttempts = 300; // 5 minutes
      let savedCase: any = null;
      setCaseData({
        caseId,
        confidence: 'Pending',
        risk: 'running',
        summary: 'Waiting for live FalkorDB traversal results...',
        entities: [],
        remediation: {
          action: 'Investigation in progress',
          reason: 'Waiting for connected evidence from the current case.',
          confidence: 'Pending'
        },
        graphData: { nodes: [], edges: [] }
      });

      let investigationFinished = false;

      const displayedEventKeys = new Set<string>();

      for (let attempt = 0; attempt < maxAttempts; attempt++) {
        const response = await fetch(
          `/api/cases/${encodeURIComponent(caseId)}`,
          { cache: 'no-store' }
        );

        if (!response.ok) {
          const body = await response.text();
          throw new Error(
            `Could not retrieve case (${response.status}): ${body}`
          );
        }

        savedCase = await response.json();

        const progressEvents = Array.isArray(savedCase.progress_events)
          ? savedCase.progress_events
          : [];

        // Reveal each persisted backend event once, in its original order.
        // New events arriving in later polls are appended as they are received.
        const pendingEvents = progressEvents.filter((event: any) => {
          const key = String(event.timestamp ?? '') + '|' +
            String(event.stage ?? '') + '|' +
            String(event.start_id ?? '') + '|' +
            String(event.hop ?? '') + '|' +
            String(event.message ?? '');
          return !displayedEventKeys.has(key);
        });

        for (const event of pendingEvents) {
          setQueryEvents(previous => [...previous, event]);

          if (event.stage === 'hop_results') {
            setCaseData(previous => {
              const nodesById = new Map<string, any>();
              const edgesById = new Map<string, any>();

              for (const node of previous?.graphData?.nodes || []) {
                nodesById.set(String(node.id), node);
              }
              for (const edge of previous?.graphData?.edges || []) {
                const rawEdge = edge as WorkspaceEdge & {
                  from?: string;
                  to?: string;
                  type?: string;
                  id?: string;
                  properties?: { id?: string };
                };
                const sourceId = String(rawEdge.source ?? rawEdge.from ?? "");
                const targetId = String(rawEdge.target ?? rawEdge.to ?? "");
                const type = String(rawEdge.type ?? rawEdge.label ?? "CONNECTED_TO");
                const relationshipId =
                  rawEdge.properties?.id ?? rawEdge.id ?? "";
                if (sourceId && targetId) {
                  edgesById.set(
                    `${sourceId}|${type}|${targetId}|${relationshipId}`,
                    { ...edge, source: sourceId, target: targetId, type }
                  );
                }
              }

              const colors: Record<string, string> = {
                Account: '#60a5fa',
                Message: '#facc15',
                IncomingMessage: '#facc15',
                Domain: '#c084fc',
                ObservedDomain: '#c084fc',
                Report: '#fb7185',
                Evidence: '#34d399',
                Brand: '#f97316',
                Scenario: '#a78bfa',
                Post: '#38bdf8',
                PaymentIdentifier: '#f472b6'
              };

              for (const node of Array.isArray(event.nodes) ? event.nodes : []) {
                const properties = node.properties || {};
                const id = String(node.id ?? properties.id ?? '');
                if (!id) continue;

                const labels = Array.isArray(node.labels) ? node.labels : [];
                const kind = labels.find(
                  (label: string) => label !== 'Entity'
                ) || 'Entity';

                nodesById.set(id, {
                  ...node,
                  id,
                  labels,
                  properties,
                  label: String(
                    properties.display_name || properties.name ||
                    properties.username || properties.domain ||
                    properties.hostname || properties.url || id
                  ),
                  color: colors[kind] || '#94a3b8'
                });
              }

              for (const edge of Array.isArray(event.edges) ? event.edges : []) {
                const sourceId = String(edge.from ?? edge.source ?? '');
                const targetId = String(edge.to ?? edge.target ?? '');
                const type = String(edge.type ?? edge.label ?? 'CONNECTED_TO');

                if (!sourceId || !targetId) continue;

                const relationshipId =
                  edge.properties?.id ?? edge.id ?? "";
                edgesById.set(
                  `${sourceId}|${type}|${targetId}|${relationshipId}`,
                  {
                    ...edge,
                    source: sourceId,
                    target: targetId,
                    type
                  }
                );
              }

              if (!previous) {
                return null;
              }

              return {
                ...previous,
                caseId,
                graphData: {
                  nodes: [...nodesById.values()],
                  edges: [...edgesById.values()]
                }
              };
            });
          }

          displayedEventKeys.add(
            String(event.timestamp ?? '') + '|' +
            String(event.stage ?? '') + '|' +
            String(event.start_id ?? '') + '|' +
            String(event.hop ?? '') + '|' +
            String(event.message ?? '')
          );

          // Visual pacing only; event contents still come from FalkorDB.
          await new Promise(resolve => setTimeout(resolve, 350));
        }

        const status = String(savedCase.status || '').toLowerCase();

        if (status === 'investigation_failed') {
          throw new Error(
            savedCase.error || 'The backend investigation failed.'
          );
        }

        if (
          status &&
          status !== 'investigating' &&
          status !== 'received'
        ) {
          investigationFinished = true;
          break;
        }

        await new Promise(resolve => setTimeout(resolve, 1000));
      }

      if (!savedCase) {
        throw new Error('No saved case response was received.');
      }

      if (!investigationFinished) {
        throw new Error(
          'Investigation is taking longer than 5 minutes. ' +
          'The saved case and progress events remain available; ' +
          'check the backend before retrying.'
        );
      }

      const finalStatus = String(savedCase.status || '').toLowerCase();
      console.log('[VEYRA DEBUG] Saved case:', {
        caseId,
        status: finalStatus,
        keys: Object.keys(savedCase),
        findingsCount: Array.isArray(savedCase.findings)
          ? savedCase.findings.length
          : 'findings is not an array',
        findingsSample: savedCase.findings?.slice?.(0, 3),
        assessment: savedCase.assessment,
        initialAssessment: savedCase.initial_assessment
      });

      if (finalStatus === 'investigating' || finalStatus === 'received') {
        throw new Error(
          'The investigation is still running. Open this case again to retrieve its latest status.'
        );
      }

      setActiveStage(3);

      const findings = Array.isArray(savedCase.findings)
        ? savedCase.findings
        : [];

      const entities: { type: string; name: string; risk: string }[] = [];
      const addEntity = (type: string, value: unknown, risk: string) => {
        if (typeof value !== 'string' || !value.trim()) return;
        if (entities.some(item => item.type === type && item.name === value)) return;
        entities.push({ type, name: value, risk });
      };

      findings.forEach((finding: any) => {
        addEntity('Domain', finding.domain, 'Observed in case findings');
        addEntity('Account', finding.connected_account_id, 'Connected graph record');
        addEntity('Report', finding.report_id, 'Existing report record');
      });

      // Recover domains from API output or the submitted message.
      const extractedDomainsForDisplay: string[] = Array.isArray(
        submitted.observed_domains
      )
        ? submitted.observed_domains.filter(
            (value: unknown): value is string =>
              typeof value === 'string' && value.trim().length > 0
          )
        : [];

      const submittedText = String(
        (submitted as any).message ||
        (submitted as any).text ||
        initialMessage ||
        ''
      );

      const urlMatches = submittedText.match(/https?:\/\/[^\s<>"']+/gi) || [];
      for (const rawUrl of urlMatches) {
        try {
          const hostname = new URL(rawUrl.replace(/[),.!?]+$/, '')).hostname;
          if (
            hostname &&
            !extractedDomainsForDisplay.some(
              domain => domain.toLowerCase() === hostname.toLowerCase()
            )
          ) {
            extractedDomainsForDisplay.push(hostname);
          }
        } catch {
          // Ignore malformed URLs; never infer a domain from arbitrary text.
        }
      }

      extractedDomainsForDisplay.forEach((domain: string) => {
        addEntity(
          'Observed domain',
          domain,
          'Observed in submitted message; not independently verified'
        );
      });

      // Prefer the graph snapshot produced by the backend investigation.
      // This avoids a burst of extra FalkorDB traversals for every finding.
      const snapshot = savedCase.graph_snapshot;
      const snapshotNodes = Array.isArray(snapshot?.nodes) ? snapshot.nodes : [];
      const snapshotEdges = Array.isArray(snapshot?.edges) ? snapshot.edges : [];
      const targetIds = new Set<string>();
      findings.forEach((finding: any) => {
        if (typeof finding.connected_account_id === 'string') {
          targetIds.add(finding.connected_account_id);
        }
        if (typeof finding.report_id === 'string') {
          targetIds.add(finding.report_id);
        }
      });

      const domainNames: string[] = [...new Set<string>(
        findings
          .map((finding: any) => finding.domain)
          .filter((value: unknown): value is string =>
            typeof value === 'string' && value.trim().length > 0
          )
      )];

      const allNodes = new Map<string, any>();
      const allEdges = new Map<string, any>();
      const normalizeNode = (node: any) => {
        const props = node.properties || {};
        const id = String(node.id ?? props.id ?? '');
        if (id) allNodes.set(id, { ...node, id, properties: props });
      };
      const normalizeEdge = (edge: any) => {
        const from = String(edge.from ?? edge.source ?? '');
        const to = String(edge.to ?? edge.target ?? '');
        const type = String(edge.type ?? edge.label ?? 'CONNECTED_TO');
        if (from && to) allEdges.set(`${from}|${type}|${to}`, { ...edge, from, to, type });
      };

      // Snapshot records came from the backend's persisted FalkorDB traversal.
      for (const node of snapshotNodes) normalizeNode(node);
      for (const edge of snapshotEdges) normalizeEdge(edge);

      // Legacy cases may not have a snapshot. Fall back to just one bounded
      // traversal, rather than querying every discovered account separately.
      if (allNodes.size === 0 && targetIds.size > 0) {
        const id = [...targetIds][0];
        try {
          const response = await fetch(
            `/api/entities/${encodeURIComponent(id)}/graph?max_hops=2&limit=25`,
            { cache: 'no-store' }
          );
          if (response.ok) {
            const payload = await response.json();
            (payload.nodes || []).forEach(normalizeNode);
            (payload.edges || []).forEach(normalizeEdge);
          } else {
            console.warn('Legacy graph fallback returned:', response.status);
          }
        } catch (error) {
          console.warn('Legacy graph fallback failed:', error);
        }
      }

      // Resolve each hostname against the actual FalkorDB graph.
      // Account traversals are bounded subsets and may not include Domain nodes.
      if (domainNames.length > 0) {
        try {
          const graphResponse = await fetch('/api/graph', {
            cache: 'no-store'
          });

          if (graphResponse.ok) {
            const graphPayload = await graphResponse.json();
            const graphNodes = Array.isArray(graphPayload.nodes)
              ? graphPayload.nodes
              : [];

            for (const domainName of domainNames) {
              const normalizeDomain = (value: string) =>
                value.trim().toLowerCase()
                  .replace(/^https?:\/\//, '')
                  .replace(/\/+$/, '');

              const normalizedDomain = normalizeDomain(domainName);

              const domainNode = graphNodes.find((node: any) => {
                const props = node.properties || {};
                const labels = Array.isArray(node.labels) ? node.labels : [];
                const candidates = [
                  props.domain,
                  props.name,
                  props.hostname,
                  props.url,
                  props['observed-domain'],
                  props.id,
                ];

                const isDomainNode =
                  labels.includes('Domain') ||
                  labels.includes('ObservedDomain');

                return isDomainNode && candidates.some((value: unknown) => {
                  if (typeof value !== 'string') return false;

                  const candidate = normalizeDomain(value);

                  return candidate === normalizedDomain ||
                    candidate === `observed-domain:${normalizedDomain}`;
                });
              });

              const domainId = domainNode?.properties?.id;
              if (!domainId) {
                console.warn('Domain node not found in graph response:', domainName);
                continue;
              }

              try {
                const response = await fetch(
                  `/api/entities/${encodeURIComponent(String(domainId))}/graph?max_hops=2&limit=100`,
                  { cache: 'no-store' }
                );

                if (!response.ok) {
                  console.warn('Domain traversal returned:', response.status, domainId);
                  continue;
                }

                const payload = await response.json();

                for (const node of payload.nodes || []) {
                  const id = String(node.id ?? node.properties?.id ?? '');
                  if (id) allNodes.set(id, node);
                }

                for (const edge of payload.edges || []) {
                  const from = String(edge.from);
                  const to = String(edge.to);
                  const key = `${from}|${edge.type}|${to}`;
                  allEdges.set(key, edge);
                }
              } catch (error) {
                console.warn('Could not load domain traversal:', domainId, error);
              }
            }
          } else {
            console.warn('Could not resolve domain IDs:', graphResponse.status);
          }
        } catch (error) {
          console.warn('Could not resolve graph domains:', error);
        }
      }

      const nodes = [...allNodes.values()].map((node: any) => {
        const props = node.properties || {};
        const labels = Array.isArray(node.labels) ? node.labels : [];
        const type = labels.find((label: string) => label !== 'Entity')
          || node.type || 'Entity';

        return {
          id: String(node.id ?? props.id),
          type,
          name: String(
            props.name || props.username || props.domain ||
            props.hostname || props.url || props.id || type
          ),
          color: type === 'Account' ? 0x3B82F6
            : type === 'Domain' || type === 'ObservedDomain' ? 0xF59E0B
            : type === 'Report' ? 0xEF4444
            : 0x94A3B8
        };
      });

      // Keep the observed domain visible even when traversal finds no matches.
      for (const domain of extractedDomainsForDisplay) {
        const exists = nodes.some((node: any) =>
          String(node.name).toLowerCase() === domain.toLowerCase()
        );

        if (!exists) {
          nodes.push({
            id: `observed:${domain}`,
            type: 'ObservedDomain',
            name: domain,
            color: 0xF59E0B
          });
        }
      }

      const nodeIds = new Set(nodes.map((node: any) => node.id));
      const edges = [...allEdges.values()]
        .map((edge: any) => ({
          source: String(edge.from),
          target: String(edge.to),
          label: String(edge.type || 'CONNECTED_TO')
        }))
        .filter((edge: any) =>
          nodeIds.has(edge.source) && nodeIds.has(edge.target)
        );

      console.log('[VEYRA DEBUG] Final display data:', {
        entityCount: entities.length,
        entitiesSample: entities.slice(0, 10),
        nodeCount: nodes.length,
        nodeSample: nodes.slice(0, 10),
        edgeCount: edges.length,
        edgeSample: edges.slice(0, 10),
        domains: extractedDomainsForDisplay
      });

      setActiveStage(6);
      setCaseData({
        caseId,
        confidence: 'Not scored',
        risk: String(
          savedCase.status || finalStatus || 'Assessment pending'
        ).replaceAll('_', ' '),
        summary: String(
          savedCase.assessment
          || savedCase.initial_assessment
          || submitted.assessment
          || 'Investigation finished. Review the saved findings before drawing conclusions.'
        ),
        entities,
        remediation: (() => {
          const warningIndicators = Array.isArray(submitted.indicators)
            ? submitted.indicators : [];
          const hasConnectedEvidence = findings.length > 0 || nodes.length > 0;
          const hasWarning = warningIndicators.length > 0;
          if (finalStatus === 'investigation_failed') return {
            action: 'Review investigation failure',
            reason: 'The investigation did not complete. Do not message, block, or label the account based on incomplete results.',
            confidence: 'Unavailable'
          };
          if (hasWarning || hasConnectedEvidence) return {
            action: 'Check this account before messaging',
            reason: hasWarning
              ? 'This message contains warning signs. Avoid sharing personal information or clicking links until you have checked whether the sender is genuine.'
              : 'VEYRA found related records, but that alone does not mean this account is dangerous. Check the evidence before messaging or blocking.',
            confidence: 'Not scored'
          };
          return {
            action: "We could not verify whether this account is safe",
            reason: "We did not find enough evidence to decide. This does not prove the account is safe or unsafe. Verify the sender through an independent, trusted channel before replying.",
            confidence: 'Insufficient evidence'
          };
        })(),
        graphData: { nodes, edges }
      });

      setWorkflowState(
        finalStatus === 'needs_review' || finalStatus === 'completed'
          ? 'completed'
          : 'failed'
      );
    } catch (error) {
      console.error('Veyra investigation failed:', error);
      setWorkflowState('failed');
      setCaseData(prev => prev ? {
        ...prev,
        summary: error instanceof Error
          ? error.message
          : 'The investigation could not be completed.'
      } : prev);
    }
  };

  // 3D Graph Initialization
  useEffect(() => {
    if (workflowState === 'idle' || !caseData?.graphData?.nodes?.length || !graphContainerRef.current) return;

    let renderer: any, scene: any, camera: any, animationFrameId: number | undefined;
    let graphCleanup: (() => void) | undefined;

    const initGraph = async () => {
      const container = graphContainerRef.current;
      if (!container) return;
      if (!window.THREE) {
        await new Promise((resolve) => {
          const script = document.createElement('script');
          script.src = 'https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js';
          script.onload = resolve;
          document.head.appendChild(script);
        });
      }

      const THREE = window.THREE;
      if (!THREE) throw new Error('Three.js failed to load.');
      const width = container.clientWidth;
      const height = container.clientHeight;

      if (width <= 0 || height <= 0) {
        console.error('Veyra graph container has no visible dimensions.', {
          width, height
        });
        container.innerHTML =
          '<div style="padding:24px;color:#F59E0B;font:14px monospace">Graph container has no visible dimensions. Reopen the investigation.</div>';
        return;
      }

      scene = new THREE.Scene();
      scene.background = new THREE.Color(showFalkorView ? 0x07120f : 0x070709);

      camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
      camera.position.set(0, 0, 4);

      renderer = new THREE.WebGLRenderer({ antialias: true, alpha: false });
      renderer.setSize(width, height);
      renderer.setClearColor(showFalkorView ? 0x07120f : 0x070709, 1);
      
      container.innerHTML = '';
      container.appendChild(renderer.domElement);

      scene.add(new THREE.AmbientLight(0xffffff, 2));
      const dirLight = new THREE.DirectionalLight(0xffffff, 1.5);
      dirLight.position.set(5, 10, 7);
      scene.add(dirLight);

      const group = new THREE.Group();
      scene.add(group);

      const nodeMeshes: Record<string, any> = {};
      const totalNodes = caseData.graphData.nodes.length;
      const radius = Math.max(0.8, Math.min(2.2, totalNodes * 0.12));

      caseData.graphData.nodes.forEach((n, idx) => {
        const angle = (idx / Math.max(totalNodes, 1)) * Math.PI * 2;
        const vertical = ((idx % 3) - 1) * 0.35;
        const pos = [
          Math.cos(angle) * radius,
          Math.sin(angle) * radius * 0.65 + vertical,
          Math.sin(angle * 2) * 0.45
        ];
        const geo = new THREE.SphereGeometry(0.18, 32, 32);
        const mat = new THREE.MeshStandardMaterial({
          color: n.color,
          roughness: 0.2,
          metalness: 0.8,
          emissive: n.color,
          emissiveIntensity: 0.5
        });
        const mesh = new THREE.Mesh(geo, mat);
        mesh.position.set(...pos);
        mesh.userData = {
          ...n,
          revealAt: performance.now() + idx * 28
        };
        mesh.scale.setScalar(0.001);
        group.add(mesh);
        nodeMeshes[n.id] = mesh;
      });


      const edgeLines: any[] = [];
      const edgeMeta: Array<{ source: any; target: any; type: string; properties: any }> = [];

      const relationshipColor = (type: string) => {
        const t = type.toUpperCase();
        if (t.includes("REPORT") || t.includes("BLOCK")) return 0xfb7185;
        if (t.includes("MESSAGE") || t.includes("SENT_TO")) return 0xfacc15;
        if (t.includes("DOMAIN") || t.includes("URL")) return 0xc084fc;
        if (t.includes("PAYMENT")) return 0xf97316;
        if (t.includes("EVIDENCE") || t.includes("SUPPORTED")) return 0x34d399;
        if (t.includes("FRIEND") || t.includes("CONNECTED")) return 0x60a5fa;
        return 0x64748b;
      };

      caseData.graphData.edges.forEach((e: any) => {
        const src = nodeMeshes[String(e.source)];
        const tgt = nodeMeshes[String(e.target)];
        if (!src || !tgt) return;

        const type = String(e.type || e.relationship || "CONNECTED_TO");
        const lineGeo = new THREE.BufferGeometry().setFromPoints([
          src.position, tgt.position
        ]);
        const lineMat = new THREE.LineBasicMaterial({
          color: relationshipColor(type),
          transparent: true,
          opacity: 0.78
        });
        const line = new THREE.Line(lineGeo, lineMat);
        line.userData = { isEdge: true, type };
        group.add(line);
        edgeLines.push(line);
        edgeMeta.push({
          source: src,
          target: tgt,
          type,
          properties: e.properties || {}
        });
      });

      const raycaster = new THREE.Raycaster();
      const mouse = new THREE.Vector2();
      const tooltip = document.createElement("div");
      tooltip.style.cssText =
        "position:absolute;display:none;z-index:40;pointer-events:none;" +
        "max-width:340px;padding:12px 14px;border:1px solid #475569;" +
        "border-radius:10px;background:rgba(5,10,18,.97);color:#e2e8f0;" +
        "font:12px/1.55 ui-monospace,monospace;white-space:pre-wrap;" +
        "overflow-wrap:anywhere;box-shadow:0 0 24px rgba(52,211,153,.12)";
      container.style.position = "relative";
      container.appendChild(tooltip);

      let draggedNode: any = null;
      let isRotating = false;
      let pointerDown = { x: 0, y: 0 };
      let previousMousePosition = { x: 0, y: 0 };
      let hasMoved = false;

      const setRay = (event: PointerEvent) => {
        const rect = renderer.domElement.getBoundingClientRect();
        mouse.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
        mouse.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;
        raycaster.setFromCamera(mouse, camera);
      };

      const onPointerDown = (event: PointerEvent) => {
        if (event.button !== 0) return;
        setRay(event);
        pointerDown = { x: event.clientX, y: event.clientY };
        previousMousePosition = { x: event.clientX, y: event.clientY };
        hasMoved = false;

        const nodeHits = raycaster.intersectObjects(
          Object.values(nodeMeshes)
        );
        draggedNode = nodeHits.length ? nodeHits[0].object : null;
        isRotating = !draggedNode;
        renderer.domElement.style.cursor = draggedNode ? "grabbing" : "grab";
        renderer.domElement.setPointerCapture?.(event.pointerId);
      };

      const onPointerMove = (event: PointerEvent) => {
        setRay(event);
        if (
          Math.abs(event.clientX - pointerDown.x) > 3 ||
          Math.abs(event.clientY - pointerDown.y) > 3
        ) hasMoved = true;

        if (draggedNode) {
          // Move the selected node on a camera-facing plane.
          const rect = renderer.domElement.getBoundingClientRect();
          const dx = (event.clientX - previousMousePosition.x) / rect.width;
          const dy = (event.clientY - previousMousePosition.y) / rect.height;
          const distance = Math.max(1, camera.position.length());
          draggedNode.position.x += dx * distance * 2;
          draggedNode.position.y -= dy * distance * 2;
          draggedNode.userData.manuallyMoved = true;
          renderer.domElement.style.cursor = "grabbing";
        } else if (isRotating) {
          group.rotation.y += (event.clientX - previousMousePosition.x) * 0.005;
          group.rotation.x += (event.clientY - previousMousePosition.y) * 0.005;
        } else {
          const hits = raycaster.intersectObjects(Object.values(nodeMeshes));
          if (hits.length) {
            const n = hits[0].object.userData || {};
            tooltip.style.display = "block";
            tooltip.style.left = `${Math.min(event.offsetX + 14, Math.max(8, container.clientWidth - 350))}px`;
            tooltip.style.top = `${Math.max(8, event.offsetY + 14)}px`;

            const connected = edgeMeta
              .filter(edge => edge.source === hits[0].object || edge.target === hits[0].object)
              .slice(0, 12)
              .map(edge => {
                const other = edge.source === hits[0].object ? edge.target : edge.source;
                return `${edge.source === hits[0].object ? "→" : "←"} ${edge.type} · ${other.userData?.name || other.userData?.label || other.userData?.id || "Entity"}`;
              });

            tooltip.style.borderColor = `#${Number(n.color || 0x34d399).toString(16).padStart(6, "0")}`;
            tooltip.textContent =
              `${(n.kind || n.labels?.[0] || "ENTITY").toString().toUpperCase()}\n` +
              `${n.name || n.label || n.id || "Unknown"}\nID: ${n.id || "Unavailable"}\n\n` +
              `PROPERTIES\n${JSON.stringify(n.properties || n, null, 2).slice(0, 1000)}\n\n` +
              `CONNECTED RELATIONSHIPS\n${connected.join("\n") || "No connected edges in this result"}`;
            renderer.domElement.style.cursor = "pointer";
          } else {
            const edgeHits = raycaster.intersectObjects(edgeLines);
            if (edgeHits.length) {
              const edgeIndex = edgeLines.indexOf(edgeHits[0].object);
              const edge = edgeMeta[edgeIndex];
              tooltip.style.display = "block";
              tooltip.style.left = `${Math.min(event.offsetX + 14, Math.max(8, container.clientWidth - 350))}px`;
              tooltip.style.top = `${Math.max(8, event.offsetY + 14)}px`;
              tooltip.textContent =
                `FALKORDB RELATIONSHIP\n` +
                `${edge.source.userData?.name || edge.source.userData?.id} \n` +
                `── ${edge.type} →\n` +
                `${edge.target.userData?.name || edge.target.userData?.id}\n\n` +
                `PROPERTIES\n${JSON.stringify(edge.properties, null, 2).slice(0, 800)}`;
              renderer.domElement.style.cursor = "crosshair";
            } else {
              tooltip.style.display = "none";
              renderer.domElement.style.cursor = "grab";
            }
          }
        }

        previousMousePosition = { x: event.clientX, y: event.clientY };
      };

      const onPointerUp = (event: PointerEvent) => {
        if (!hasMoved && !draggedNode) {
          setRay(event);
          const hits = raycaster.intersectObjects(Object.values(nodeMeshes));
          if (hits.length && hits[0].object.userData?.id) {
            setSelectedNode(hits[0].object.userData);
          }
        }
        draggedNode = null;
        isRotating = false;
        renderer.domElement.style.cursor = "grab";
      };

      renderer.domElement.style.cursor = "grab";
      renderer.domElement.addEventListener("pointerdown", onPointerDown);
      renderer.domElement.addEventListener("pointermove", onPointerMove);
      renderer.domElement.addEventListener("pointerup", onPointerUp);
      renderer.domElement.addEventListener("pointercancel", onPointerUp);
      graphCleanup = () => {
        renderer.domElement.removeEventListener("pointerdown", onPointerDown);
        renderer.domElement.removeEventListener("pointermove", onPointerMove);
        renderer.domElement.removeEventListener("pointerup", onPointerUp);
        renderer.domElement.removeEventListener("pointercancel", onPointerUp);
        if (tooltip.parentElement === container) container.removeChild(tooltip);
      };

      const animate = () => {
        animationFrameId = requestAnimationFrame(animate);

        // Stagger each node's entrance when a case graph is revealed.
        const now = performance.now();
        Object.values(nodeMeshes).forEach((mesh: any) => {
          const revealAt = Number(mesh.userData?.revealAt || 0);
          const progress = Math.max(0, Math.min(1, (now - revealAt) / 320));
          const eased = 1 - Math.pow(1 - progress, 3);
          mesh.scale.setScalar(Math.max(0.001, eased));
        });

        if (!draggedNode && !isRotating) {
          group.rotation.y += 0.002;
        }

        edgeLines.forEach((line: any, index: number) => {
          const edge = edgeMeta[index];
          if (edge) {
            line.geometry.setFromPoints([
              edge.source.position,
              edge.target.position
            ]);
          }
        });

        renderer.render(scene, camera);
      };
      
      setGraphReady(true);
      animate();
    };

    initGraph();

    return () => {
      if (animationFrameId) cancelAnimationFrame(animationFrameId);
      graphCleanup?.();
      if (renderer) renderer.dispose();
    };
  }, [
    workflowState,
    caseData?.caseId,
    caseData?.graphData?.nodes?.length,
    caseData?.graphData?.edges?.length
    ,showFalkorView
  ]);

  return (
    <div className="relative min-h-full w-full bg-[#070709] text-slate-200 font-sans overflow-x-hidden m-0 p-0 selection:bg-[#FFCC00] selection:text-black">
      
      {/* Investigation Header */}
      <header className="sticky top-0 z-50 flex items-center justify-between px-6 lg:px-10 py-5 border-b border-white/5 bg-[#070709]/90 backdrop-blur-md shrink-0">
        <div>
          <h1 className="text-xl lg:text-2xl font-extrabold text-white tracking-tight flex items-center gap-3">
            Investigation Workspace
            {workflowState !== 'idle' && (
              <span className={`text-[10px] font-mono font-bold px-2.5 py-1 rounded border ${
                workflowState === 'running' ? 'bg-[#FFCC00]/10 text-[#FFCC00] border-[#FFCC00]/30 animate-pulse' :
                workflowState === 'completed' ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30' :
                'bg-red-500/10 text-red-400 border-red-500/30'
              }`}>
                {workflowState.toUpperCase()} {caseData?.caseId && `• ${caseData.caseId}`}
              </span>
            )}
          </h1>
          <p className="text-xs text-slate-400 mt-1">Investigate suspicious activity through connected evidence.</p>
        </div>
        <div>
          {workflowState !== 'idle' && (
            <button 
              onClick={() => onClose ? onClose() : window.location.reload()} 
              className="px-4 py-2 rounded-lg bg-white/5 hover:bg-white/10 border border-white/10 text-white font-bold text-xs transition-colors"
            >
              New Investigation
            </button>
          )}
        </div>
      </header>

      <main className="w-full max-w-6xl mx-auto p-6 lg:p-10 flex flex-col gap-8 pb-20">
        
        {/* Mode B Input Form (Shown only when opened from tab and idle) */}
        {workflowState === 'idle' && entryMode === 'B' && (
          <div className="bg-[#101015] border border-white/5 rounded-xl p-6 shadow-2xl flex flex-col gap-4">
            <div className="flex flex-col gap-1.5">
              <label className="text-[10px] font-mono text-slate-400 font-bold uppercase tracking-wider">Investigation Question / Incident Description</label>
              <textarea
                value={investigationQuery}
                onChange={(e) => setInvestigationQuery(e.target.value)}
                placeholder="Type or paste the suspicious message / question here (e.g. Investigate whether this account is connected to phishing domains...)"
                className="w-full bg-[#070709] border border-white/10 rounded-lg p-4 text-sm text-white focus:border-[#FFCC00] focus:ring-1 focus:ring-[#FFCC00] focus:outline-none resize-none h-28 transition-all"
                required
              />
            </div>

            <details className="group cursor-pointer">
              <summary className="text-[11px] text-[#FFCC00] font-bold select-none flex items-center gap-2 outline-none">
                <span className="transition-transform group-open:rotate-90">▶</span>
                Show Advanced Parameters (Suspect ID, Domain, Context)
              </summary>
              <div className="grid grid-cols-1 md:grid-cols-2 gap-4 pt-4 mt-2 border-t border-white/5">
                <div className="flex flex-col gap-1.5">
                  <label className="text-[10px] font-mono text-slate-400 font-bold uppercase">Suspect ID</label>
                  <input type="text" value={suspectId} onChange={(e)=>setSuspectId(e.target.value)} className="bg-[#070709] border border-white/10 rounded-lg p-2.5 text-xs text-white focus:border-[#FFCC00] outline-none transition-all" />
                </div>
                <div className="flex flex-col gap-1.5">
                  <label className="text-[10px] font-mono text-slate-400 font-bold uppercase">Target Domain / URL</label>
                  <input type="text" value={targetUrl} onChange={(e)=>setTargetUrl(e.target.value)} className="bg-[#070709] border border-white/10 rounded-lg p-2.5 text-xs text-white focus:border-[#FFCC00] outline-none transition-all" />
                </div>
              </div>
            </details>

            <div className="flex justify-end mt-4">
              <button
                onClick={startInvestigation}
                disabled={!investigationQuery.trim()}
                className={`px-6 py-2.5 font-extrabold text-xs rounded-lg shadow-lg transition-all ${
                  investigationQuery.trim() 
                    ? 'bg-[#FFCC00] hover:bg-[#e6b800] text-black shadow-[#FFCC00]/10 cursor-pointer' 
                    : 'bg-white/5 text-slate-500 cursor-not-allowed shadow-none border border-white/10'
                }`}
              >
                Proceed & Investigate with Veyra →
              </button>
            </div>
          </div>
        )}

        {/* Live Execution Stepper (Active in Mode A instantly or Mode B after clicking proceed) */}
        {workflowState !== 'idle' && (
          <div className="bg-[#101015] border border-white/5 rounded-xl p-6 shadow-2xl flex flex-col gap-6 animate-in fade-in">
            <h3 className="text-white font-bold text-sm flex items-center gap-2">
              <span className={`w-2 h-2 rounded-full ${workflowState === 'running' ? 'bg-[#FFCC00] animate-ping' : 'bg-emerald-500'}`}></span>
              Live Execution Workflow {entryMode === 'A' && '• Started directly from DM'}
            </h3>
            
            <div className="relative flex items-center justify-between w-full overflow-hidden px-2 pb-2">
              {stages.map((stage, index) => {
                const stageNum = stage.id;
                const isCompleted = activeStage > stageNum || workflowState === 'completed';
                const isRunning = activeStage === stageNum && workflowState === 'running';
                
                return (
                  <React.Fragment key={stage.id}>
                    <div className="flex flex-col items-center gap-2 relative z-10 min-w-[80px]">
                      <div className={`w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold transition-all duration-500 ${
                        isCompleted ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/50' :
                        isRunning ? 'bg-[#FFCC00]/20 text-[#FFCC00] border border-[#FFCC00] shadow-[0_0_15px_rgba(255,204,0,0.3)] scale-110' :
                        'bg-[#070709] border border-white/10 text-slate-500'
                      }`}>
                        {isCompleted ? <CheckIcon /> : stageNum}
                      </div>
                      <span className={`text-[10px] font-mono text-center whitespace-nowrap ${
                        isRunning ? 'text-[#FFCC00] font-bold' : isCompleted ? 'text-slate-300' : 'text-slate-600'
                      }`}>
                        {stage.name}
                      </span>
                    </div>

                    {index < stages.length - 1 && (
                      <div className="flex-1 h-[2px] mx-2 relative bg-white/5 overflow-hidden rounded-full">
                        <div className={`absolute top-0 left-0 h-full transition-all duration-700 ${
                          isCompleted ? 'w-full bg-emerald-500/50' : 
                          isRunning ? 'w-full bg-gradient-to-r from-transparent via-[#FFCC00] to-transparent animate-[shimmer_1.5s_infinite]' : 
                          'w-0 bg-transparent'
                        }`}></div>
                      </div>
                    )}
                  </React.Fragment>
                );
              })}
            </div>
            
            <style>{`
              @keyframes shimmer {
                0% { transform: translateX(-100%); }
                100% { transform: translateX(100%); }
              }
            `}</style>

        <div className="mt-3 grid min-w-0 grid-cols-1 gap-3 xl:grid-cols-[minmax(245px,0.95fr)_minmax(0,1.8fr)_minmax(270px,0.95fr)]">
        {/* Compact hop timeline + live FalkorDB query */}
        <section className="contents">
          <div className="col-span-full flex items-center justify-between gap-3 rounded-xl border border-white/[0.08] bg-[#0b0b10] px-4 py-3">
            <div>
              <h2 className="text-sm font-semibold text-white">FalkorDB traversal</h2>
              <p className="mt-0.5 text-[10px] text-slate-500">
                {queryEvents.filter((e: any) => e.stage === "hop_results").length} hop results received
              </p>
            </div>
            <span className={`rounded-full border px-2.5 py-1 text-[10px] ${
              workflowState === "running"
                ? "border-yellow-400/25 text-yellow-300"
                : workflowState === "completed"
                  ? "border-emerald-400/25 text-emerald-300"
                  : workflowState === "failed"
                    ? "border-red-400/25 text-red-300"
                    : "border-white/10 text-slate-500"
            }`}>
              {workflowState}
            </span>
          </div>

          {(() => {
            const events = queryEvents;
            let latestIndex = -1;
            for (let i = events.length - 1; i >= 0; i--) {
              if (events[i].stage === "query_started") {
                latestIndex = i;
                break;
              }
            }
            const latest = latestIndex >= 0 ? events[latestIndex] : null;
            const outcome = latest
              ? events.slice(latestIndex + 1).find((e: any) =>
                  e.start_id === latest.start_id &&
                  e.hop === latest.hop &&
                  (e.stage === "query_completed" || e.stage === "query_failed")
                ) ?? null
              : null;
            const status = !latest
              ? (workflowState === "running" ? "waiting" : "completed")
              : !outcome
                ? (workflowState === "running" ? "running" : "completed")
                : outcome.stage === "query_failed" ? "failed" : "completed";
            const hops = events.filter((e: any) => e.stage === "hop_results");

            return (
              <>
                <div className="min-w-0 overflow-hidden rounded-xl border border-yellow-300/20 bg-[#0b0b10] px-4 py-3 xl:col-start-3 xl:row-start-2">
                  <div className="mb-2 flex items-center justify-between gap-3">
                    <span className="text-[10px] font-mono uppercase tracking-wider text-slate-500">
                      {latest ? `Hop ${latest.hop ?? "—"} · Cypher` : "Current query"}
                    </span>
                    <span className={`text-[10px] ${
                      status === "running" ? "animate-pulse text-yellow-300"
                        : status === "completed" ? "text-emerald-300"
                        : status === "failed" ? "text-red-300" : "text-slate-500"
                    }`}>
                      {status === "running" ? "● Executing" : status === "completed" ? "✓ Completed"
                        : status === "failed" ? "× Failed" : "Waiting for query"}
                    </span>
                  </div>
                  <p className="mb-3 text-[11px] leading-5 text-slate-500">
                    Expand a query below to view its Cypher, inputs, and execution details.
                  </p>
                  <div className="mt-4 border-t border-white/[0.07] pt-3">
                    <div className="mb-2 flex items-center justify-between gap-2">
                      <p className="text-[10px] font-mono uppercase tracking-wider text-yellow-200">Query history</p>
                      <span className="text-[10px] text-slate-500">
                        {events.filter((e: any) => e.stage === "query_started").length} executions
                      </span>
                    </div>
                    <div className="space-y-2">
                      {events.filter((e: any) => e.stage === "query_started").map((queryEvent: any, index: number) => {
                        const queryOutcome = events.slice(
                          events.indexOf(queryEvent) + 1
                        ).find((e: any) =>
                          e.start_id === queryEvent.start_id &&
                          e.hop === queryEvent.hop &&
                          (e.stage === "query_completed" || e.stage === "query_failed")
                        );
                        return (
                          <details
                            key={`${queryEvent.start_id ?? "start"}-${queryEvent.timestamp ?? index}-${index}`}
                            className="rounded-lg border border-white/[0.07] bg-black/20 px-3 py-2"
                          >
                            <summary className="flex cursor-pointer list-none flex-wrap items-center justify-between gap-2 text-[11px] text-slate-300 hover:text-yellow-200">
                              <span>Query {index + 1} · Hop {queryEvent.hop ?? "—"}</span>
                              <span className="text-[10px] text-slate-500">
                                {queryOutcome?.stage === "query_failed" ? "Failed" : queryOutcome ? "Completed" : "Started"}
                              </span>
                            </summary>
                            <div className="mt-2 space-y-2">
                              <p className="text-[11px] leading-5 text-slate-400">
                                This query explores entities connected to the current frontier. Expand the Cypher below to inspect the exact matching rules and filters used.
                              </p>
                              {queryEvent.query ? (
                                <pre className="max-h-48 overflow-auto whitespace-pre-wrap break-words rounded-md border border-white/[0.06] bg-black/40 p-2 font-mono text-[10px] leading-4 text-yellow-100/90">{String(queryEvent.query)}</pre>
                              ) : (
                                <p className="text-[10px] text-slate-500">Query text was not included in this event.</p>
                              )}
                              {queryEvent.parameters && (
                                <details className="rounded border border-white/[0.06] p-2">
                                  <summary className="cursor-pointer text-[10px] text-slate-400 hover:text-slate-200">View parameters</summary>
                                  <pre className="mt-2 max-h-28 overflow-auto whitespace-pre-wrap break-words font-mono text-[10px] text-slate-400">{JSON.stringify(queryEvent.parameters, null, 2)}</pre>
                                </details>
                              )}
                              {queryOutcome?.elapsed_ms != null && (
                                <p className="text-[10px] text-slate-500">Execution time: {queryOutcome.elapsed_ms} ms</p>
                              )}
                              {queryOutcome?.message && queryOutcome.stage === "query_failed" && (
                                <p className="text-[10px] text-red-300">{queryOutcome.message}</p>
                              )}
                            </div>
                          </details>
                        );
                      })}
                      {events.filter((e: any) => e.stage === "query_started").length === 0 && (
                        <p className="text-[10px] text-slate-500">Query history appears when actual query execution events are recorded.</p>
                      )}
                    </div>
                  </div>
                </div>

                <div className="min-w-0 overflow-y-auto rounded-xl border border-emerald-300/20 bg-[#0b0b10] px-4 py-3 xl:col-start-1 xl:row-start-2 xl:max-h-[680px]">
                  <p className="mb-3 text-[10px] font-mono uppercase tracking-wider text-emerald-300">Hop timeline</p>
                  {hops.length === 0 ? (
                    <p className="py-2 text-[11px] text-slate-500">
                      {workflowState === "running" ? "Waiting for the first hop results…" : "No hop results recorded."}
                    </p>
                  ) : (
                    <div className="relative">
                      <div className="absolute bottom-3 left-[6px] top-2 w-px bg-white/10" />
                      <div className="space-y-3">
                        {hops.map((event: any, index: number) => (
                          <div key={`${event.hop}-${event.timestamp || index}`} className="relative flex items-start gap-3 pl-0">
                            <span className="z-10 mt-1 flex h-[13px] w-[13px] shrink-0 items-center justify-center rounded-full border border-emerald-400 bg-[#0b0b10]">
                              <span className="h-1 w-1 rounded-full bg-emerald-300" />
                            </span>
                            <div className="min-w-0 flex-1 rounded-lg border border-white/[0.06] bg-white/[0.015] px-3 py-2">
                              <div className="flex min-w-0 flex-col items-start gap-1">
                                <span className="max-w-full break-words text-xs font-medium text-slate-200">
                                  Hop {event.hop} traversal
                                </span>
                                <span className="block max-w-full whitespace-normal break-words text-[10px] leading-4 text-slate-500">
                                  {events.filter((q: any) => q.stage === "query_started" && q.hop === event.hop).length} executions · {event.node_count ?? 0} nodes · {event.edge_count ?? 0} links
                                </span>
                              </div>
                              <p className="mt-1 text-[10px] text-slate-500">
                                {event.message || "Results returned by FalkorDB"}
                              </p>

                              {(Array.isArray(event.nodes) || Array.isArray(event.edges)) && (
                                <details className="mt-2">
                                  <summary className="cursor-pointer text-[10px] text-slate-500 hover:text-slate-300">Inspect hop results</summary>
                                  <pre className="mt-2 max-h-32 overflow-auto whitespace-pre-wrap break-words rounded bg-black/30 p-2 font-mono text-[10px] text-slate-400">{JSON.stringify({nodes: event.nodes ?? [], edges: event.edges ?? []}, null, 2)}</pre>
                                </details>
                              )}
                            </div>
                          </div>
                        ))}
                        {workflowState === "running" && (
                          <div className="relative flex items-center gap-3 pl-0">
                            <span className="z-10 ml-[2px] h-[9px] w-[9px] shrink-0 animate-pulse rounded-full bg-yellow-300 ring-4 ring-yellow-300/[0.07]" />
                            <span className="text-[11px] text-yellow-200/80">
                              {latest && status === "running" ? `Executing hop ${latest.hop}…` : "Waiting for next hop…"}
                            </span>
                          </div>
                        )}
                      </div>
                    </div>
                  )}
                </div>
              </>
            );
          })()}
        </section>

        {/* Actual graph built from the same hop results returned by FalkorDB */}
        <section className="min-w-0 overflow-hidden rounded-xl border border-emerald-300/20 bg-[#09090d] shadow-[0_0_30px_rgba(52,211,153,0.07)] xl:col-start-2 xl:row-start-2">
          <div className="flex items-center justify-between border-b border-white/[0.07] px-4 py-3">
            <div className="min-w-0">
              <div className="flex flex-wrap items-center gap-2">
                <h2 className="text-sm font-semibold text-white">
                  {showFalkorView ? "FalkorDB graph" : "Investigation graph"}
                </h2>
                <button
                  type="button"
                  onClick={() => {
                    if (showFalkorView) {
                      setShowFalkorView(false);
                    } else {
                      openInFalkorDB();
                    }
                  }}
                  className={`rounded-md border px-2.5 py-1.5 text-[10px] font-semibold transition-colors ${
                    showFalkorView
                      ? "border-emerald-400/40 bg-emerald-400/10 text-emerald-300"
                      : "border-yellow-400/40 bg-yellow-400/10 text-yellow-300 hover:bg-yellow-400/20"
                  }`}
                  title="Switch the current investigation graph to its FalkorDB view"
                >
                  Show in FalkorDB ↗
                </button>
              </div>
              <p className="mt-0.5 text-[10px] text-slate-500">
                {showFalkorView
                  ? "FalkorDB-backed nodes and relationships from this investigation"
                  : "Connected entities and relationships discovered during traversal"}
              </p>
            </div>
            <span className="shrink-0 font-mono text-[10px] text-slate-500">
              {caseData?.graphData?.nodes?.length ?? 0} nodes · {caseData?.graphData?.edges?.length ?? 0} links
            </span>
          </div>
          {caseData?.graphData?.nodes?.length ? (
            <div ref={graphContainerRef} className="h-[360px] w-full sm:h-[440px]" />
          ) : (
            <div className="flex h-48 items-center justify-center px-6 text-center">
              <p className="text-xs text-slate-500">
                {workflowState === "running"
                  ? "Graph entities will appear here as each hop returns."
                  : "Run an investigation to build the connected evidence graph."}
              </p>
            </div>
          )}
          {caseData?.graphData?.nodes?.length ? (
            <div className="border-t border-white/[0.06] px-4 py-2 text-[10px] text-slate-500">
              {showFalkorView ? 'FalkorDB view · ' : ''}Drag to rotate · Select a node to inspect it
            </div>
          ) : null}
        </section>

        {/* VEYRA_AGENT_ASSESSMENT_CARD: below the Hop 2 Cypher panel */}
        <section className="min-w-0 w-full rounded-xl border border-violet-300/20 bg-[#0b0b10] px-3 py-3 sm:px-4 sm:py-4 xl:col-start-1 xl:col-span-3 xl:row-start-3">
          <div className="mb-3 flex items-center justify-between gap-3">
            <div>
              <p className="text-[10px] font-mono uppercase tracking-widest text-violet-300">
                VEYRA AI · MCP + Groq
              </p>
              <h2 className="mt-1 text-sm font-semibold text-white">
                Agent Summary &amp; Risk Assessment
              </h2>
            </div>
            {agentAssessment?.status === "ready" && (() => {
              const match = agentAssessment.answer.match(
                /RISK LEVEL\s*:\s*(HIGH|MEDIUM|SAFE)\b/i
              );
              const risk = match?.[1]?.toUpperCase() ?? "MEDIUM";
              const riskClass =
                risk === "HIGH" ? "border-red-400/30 bg-red-400/10 text-red-300" :
                risk === "MEDIUM" ? "border-amber-400/30 bg-amber-400/10 text-amber-200" :
                "border-emerald-400/30 bg-emerald-400/10 text-emerald-300";
              return (
                <span className={`rounded-full border px-3 py-1 text-[10px] font-semibold ${riskClass}`}>
                  {risk}
                </span>
              );
            })()}
          </div>

          {!caseData ? (
            <p className="text-xs text-slate-500">
              Run an investigation to generate an agent assessment.
            </p>
          ) : !agentAssessment || agentAssessment.status === "loading" ? (
            <div className="flex items-center gap-3 py-4 text-xs text-violet-200">
              <span className="h-4 w-4 animate-spin rounded-full border-2 border-violet-300/30 border-t-violet-300" />
              Reviewing case evidence and consulting the agent...
            </div>
          ) : agentAssessment.status === "error" ? (
            <div className="rounded-lg border border-red-400/20 bg-red-400/5 p-3">
              <p className="text-xs font-medium text-red-300">
                Agent assessment could not be generated
              </p>
              <p className="mt-2 whitespace-pre-wrap break-words text-xs text-slate-400">
                {agentAssessment.error}
              </p>
              <button
                type="button"
                className="mt-3 rounded-md border border-white/10 px-3 py-1.5 text-xs text-slate-200 hover:bg-white/5"
                onClick={() => {
                  assessmentRequestedFor.current = null;
                  setAgentAssessment(null);
                }}
              >
                Retry assessment
              </button>
            </div>
          ) : (
            <div className="min-w-0 space-y-3">
              {(() => {
                const answer = agentAssessment.answer ?? "";
                const summaryMatch = answer.match(/SUMMARY\s*:\s*([\s\S]*)/i);
                const summary = (summaryMatch?.[1] ?? answer)
                  .replace(/^\s*[-–—;,:]+\s*/, "")
                  .trim();

                return (
                  <div className="min-w-0 rounded-lg border border-white/[0.07] bg-white/[0.02] p-3">
                    <p className="mb-2 text-[10px] font-mono font-semibold uppercase tracking-[0.18em] text-violet-300">
                      Summary
                    </p>
                    <p className="break-words [overflow-wrap:anywhere] text-sm leading-6 text-slate-200">
                      {summary || "No summary was returned for this assessment."}
                    </p>
                  </div>
                );
              })()}
              <p className="border-t border-white/[0.07] pt-3 text-[10px] leading-5 text-slate-500">
                Generated from the submitted case context using the existing agent.
                Risk is an evidence-based assessment, not proof of wrongdoing.
              </p>
            </div>
          )}
        </section>
        </div>

          </div>
        )}


      </main>
    </div>
  );
}
