import React, { useState, useEffect, useRef } from 'react';

// Inline Icons for Cyber-Forensics UI
const CheckIcon = () => (
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="3" strokeLinecap="round" strokeLinejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
);

type WorkspaceContext = {
  suspectId?: string;
  targetUrl?: string;
};

type SimulatorMetadata = {
  simulatorMessageId?: string | null;
  conversationId?: string | null;
  senderUsername?: string | null;
  senderAccountId?: string | null;
  senderDisplayName?: string | null;
  senderUiVerified?: boolean;
  scenarioId?: string | null;
};

type WorkspaceNode = {
  id: string;
  type: string;
  name: string;
  color?: number;
  [key: string]: unknown;
};

type WorkspaceEdge = {
  source: string;
  target: string;
  label: string;
};

type WorkspaceCaseData = {
  caseId: string;
  confidence: string;
  risk: string;
  summary: string;
  entities: { type: string; name: string; risk: string }[];
  remediation: {
    action: string;
    reason: string;
    confidence: string;
  } | null;
  graphData: {
    nodes: WorkspaceNode[];
    edges: WorkspaceEdge[];
  };
};

declare global {
  interface Window {
    THREE?: any;
  }
}


function QueryTypewriter({ text }: { text: string }) {
  const [visibleLength, setVisibleLength] = useState(0);

  useEffect(() => {
    setVisibleLength(0);
    if (!text) return;

    let index = 0;
    const interval = window.setInterval(() => {
      index = Math.min(index + 3, text.length);
      setVisibleLength(index);
      if (index >= text.length) window.clearInterval(interval);
    }, 12);

    return () => window.clearInterval(interval);
  }, [text]);

  return (
    <pre className="text-[10px] text-emerald-300 whitespace-pre-wrap break-words overflow-x-auto font-mono">
      {text.slice(0, visibleLength)}
      {visibleLength < text.length && (
        <span className="inline-block w-2 h-3 ml-0.5 align-middle bg-[#FFCC00] animate-pulse" />
      )}
    </pre>
  );
}

export default function InvestigationWorkspace({
  initialMessage = null,
  initialContext = null,
  initialMetadata = null,
  onClose
}: {
  initialMessage?: string | null;
  initialContext?: WorkspaceContext | null;
  initialMetadata?: SimulatorMetadata | null;
  onClose?: () => void;
}) {
  // Mode A if triggered from DMs/messages, Mode B if opened directly from tab
  const entryMode = initialMessage ? 'A' : 'B';
  
  const [investigationQuery, setInvestigationQuery] = useState(
    initialMessage || ''
  );
  const [suspectId, setSuspectId] = useState(initialContext?.suspectId || '');
  const [targetUrl, setTargetUrl] = useState(initialContext?.targetUrl || '');
  
  const [workflowState, setWorkflowState] = useState('idle'); // idle, running, completed, failed
  const [activeStage, setActiveStage] = useState(0);
  const [caseData, setCaseData] = useState<WorkspaceCaseData | null>(null);
  const [, setGraphReady] = useState(false);
  const [, setSelectedNode] = useState<WorkspaceNode | null>(null);
  const [queryEvents, setQueryEvents] = useState<any[]>([]);
  
  // 3D Graph Ref
  const graphContainerRef = useRef<HTMLDivElement | null>(null);

  const stages = [
    { id: 1, name: 'Create Case' },
    { id: 2, name: 'Extract Entities' },
    { id: 3, name: 'Query FalkorDB' },
    { id: 4, name: 'Analyze Connections' },
    { id: 5, name: 'Collect Evidence' },
    { id: 6, name: 'Generate Summary' }
  ];

  // If Mode A (triggered from DMs), start execution immediately
  useEffect(() => {
    if (entryMode === 'A' && workflowState === 'idle') {
      startInvestigation();
    }
  }, [entryMode]);

  const startInvestigation = async () => {
    if (workflowState === 'running') return;

    const message = investigationQuery.trim();
    if (!message) {
      setWorkflowState('failed');
      return;
    }

    setWorkflowState('running');
    setActiveStage(1);
    setGraphReady(false);
    setSelectedNode(null);

    setCaseData({
      caseId: 'Creating case...',
      confidence: 'Not calculated',
      risk: 'Pending investigation',
      summary: 'Submitting the message to the Veyra investigation backend...',
      entities: [],
      remediation: null,
      graphData: { nodes: [], edges: [] }
    });

    try {
      const submitResponse = await fetch('/api/messages/analyze', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          message,
          simulator_message_id: initialMetadata?.simulatorMessageId ?? null,
          conversation_id: initialMetadata?.conversationId ?? null,
          sender_username: initialMetadata?.senderUsername ?? null,
          sender_account_id: initialMetadata?.senderAccountId ?? null,
          sender_display_name: initialMetadata?.senderDisplayName ?? null,
          scenario_id: initialMetadata?.scenarioId ?? null,
          // UI verification badges are not trusted identity evidence.
          source: initialMetadata ? 'dm_simulator' : 'investigation_workspace'
        })
      });

      if (!submitResponse.ok) {
        const body = await submitResponse.text();
        throw new Error(
          `Could not submit investigation (${submitResponse.status}): ${body}`
        );
      }

      const submitted = await submitResponse.json();
      console.log('[VEYRA DEBUG] Submit response:', submitted);
      const caseId = submitted.case_id;

      if (!caseId) {
        throw new Error('Backend response did not contain a case ID.');
      }

      setActiveStage(2);
      setCaseData(prev => prev ? {
        ...prev,
        caseId,
        summary: 'Case saved. Retrieving its persisted investigation status...'
      } : prev);

      // Poll the persisted case until the backend reaches a terminal state.
      const maxAttempts = 300; // 5 minutes
      let savedCase: any = null;
      setCaseData({
        caseId,
        confidence: 'Pending',
        risk: 'running',
        summary: 'Waiting for live FalkorDB traversal results...',
        entities: [],
        remediation: {
          action: 'Investigation in progress',
          reason: 'Waiting for connected evidence from the current case.',
          confidence: 'Pending'
        },
        graphData: { nodes: [], edges: [] }
      });

      let investigationFinished = false;

      let displayedEventCount = 0;

      for (let attempt = 0; attempt < maxAttempts; attempt++) {
        const response = await fetch(
          `/api/cases/${encodeURIComponent(caseId)}`,
          { cache: 'no-store' }
        );

        if (!response.ok) {
          const body = await response.text();
          throw new Error(
            `Could not retrieve case (${response.status}): ${body}`
          );
        }

        savedCase = await response.json();

        const progressEvents = Array.isArray(savedCase.progress_events)
          ? savedCase.progress_events
          : [];

        // Reveal each persisted backend event once, in its original order.
        // New events arriving in later polls are appended as they are received.
        const pendingEvents = progressEvents.slice(displayedEventCount);

        for (const event of pendingEvents) {
          setQueryEvents(previous => [...previous, event]);

          if (event.stage === 'hop_results') {
            setCaseData(previous => {
              const nodesById = new Map<string, any>();
              const edgesById = new Map<string, any>();

              for (const node of previous?.graphData?.nodes || []) {
                nodesById.set(String(node.id), node);
              }
              for (const edge of previous?.graphData?.edges || []) {
                edgesById.set(
                  `${edge.source}|${edge.label}|${edge.target}`,
                  edge
                );
              }

              const colors: Record<string, string> = {
                Account: '#60a5fa',
                Message: '#facc15',
                IncomingMessage: '#facc15',
                Domain: '#c084fc',
                ObservedDomain: '#c084fc',
                Report: '#fb7185',
                Evidence: '#34d399',
                Brand: '#f97316',
                Scenario: '#a78bfa',
                Post: '#38bdf8',
                PaymentIdentifier: '#f472b6'
              };

              for (const node of Array.isArray(event.nodes) ? event.nodes : []) {
                const properties = node.properties || {};
                const id = String(node.id ?? properties.id ?? '');
                if (!id) continue;

                const labels = Array.isArray(node.labels) ? node.labels : [];
                const kind = labels.find(
                  (label: string) => label !== 'Entity'
                ) || 'Entity';

                nodesById.set(id, {
                  ...node,
                  id,
                  labels,
                  properties,
                  label: String(
                    properties.display_name || properties.name ||
                    properties.username || properties.domain ||
                    properties.hostname || properties.url || id
                  ),
                  color: colors[kind] || '#94a3b8'
                });
              }

              for (const edge of Array.isArray(event.edges) ? event.edges : []) {
                const sourceId = String(edge.from ?? edge.source ?? '');
                const targetId = String(edge.to ?? edge.target ?? '');
                const type = String(edge.type ?? edge.label ?? 'CONNECTED_TO');

                if (!sourceId || !targetId) continue;

                edgesById.set(`${sourceId}|${type}|${targetId}`, {
                  ...edge,
                  source: sourceId,
                  target: targetId,
                  type
                });
              }

              if (!previous) {
                return null;
              }

              return {
                ...previous,
                caseId,
                graphData: {
                  nodes: [...nodesById.values()],
                  edges: [...edgesById.values()]
                }
              };
            });
          }

          displayedEventCount += 1;

          // Visual pacing only; event contents still come from FalkorDB.
          await new Promise(resolve => setTimeout(resolve, 350));
        }

        const status = String(savedCase.status || '').toLowerCase();

        if (status === 'investigation_failed') {
          throw new Error(
            savedCase.error || 'The backend investigation failed.'
          );
        }

        if (
          status &&
          status !== 'investigating' &&
          status !== 'received'
        ) {
          investigationFinished = true;
          break;
        }

        await new Promise(resolve => setTimeout(resolve, 1000));
      }

      if (!savedCase) {
        throw new Error('No saved case response was received.');
      }

      if (!investigationFinished) {
        throw new Error(
          'Investigation is taking longer than 5 minutes. ' +
          'The saved case and progress events remain available; ' +
          'check the backend before retrying.'
        );
      }

      const finalStatus = String(savedCase.status || '').toLowerCase();
      console.log('[VEYRA DEBUG] Saved case:', {
        caseId,
        status: finalStatus,
        keys: Object.keys(savedCase),
        findingsCount: Array.isArray(savedCase.findings)
          ? savedCase.findings.length
          : 'findings is not an array',
        findingsSample: savedCase.findings?.slice?.(0, 3),
        assessment: savedCase.assessment,
        initialAssessment: savedCase.initial_assessment
      });

      if (finalStatus === 'investigating' || finalStatus === 'received') {
        throw new Error(
          'The investigation is still running. Open this case again to retrieve its latest status.'
        );
      }

      setActiveStage(3);

      const findings = Array.isArray(savedCase.findings)
        ? savedCase.findings
        : [];

      const entities: { type: string; name: string; risk: string }[] = [];
      const addEntity = (type: string, value: unknown, risk: string) => {
        if (typeof value !== 'string' || !value.trim()) return;
        if (entities.some(item => item.type === type && item.name === value)) return;
        entities.push({ type, name: value, risk });
      };

      findings.forEach((finding: any) => {
        addEntity('Domain', finding.domain, 'Observed in case findings');
        addEntity('Account', finding.connected_account_id, 'Connected graph record');
        addEntity('Report', finding.report_id, 'Existing report record');
      });

      // Recover domains from API output or the submitted message.
      const extractedDomainsForDisplay: string[] = Array.isArray(
        submitted.observed_domains
      )
        ? submitted.observed_domains.filter(
            (value: unknown): value is string =>
              typeof value === 'string' && value.trim().length > 0
          )
        : [];

      const submittedText = String(
        (submitted as any).message ||
        (submitted as any).text ||
        initialMessage ||
        ''
      );

      const urlMatches = submittedText.match(/https?:\/\/[^\s<>"']+/gi) || [];
      for (const rawUrl of urlMatches) {
        try {
          const hostname = new URL(rawUrl.replace(/[),.!?]+$/, '')).hostname;
          if (
            hostname &&
            !extractedDomainsForDisplay.some(
              domain => domain.toLowerCase() === hostname.toLowerCase()
            )
          ) {
            extractedDomainsForDisplay.push(hostname);
          }
        } catch {
          // Ignore malformed URLs; never infer a domain from arbitrary text.
        }
      }

      extractedDomainsForDisplay.forEach((domain: string) => {
        addEntity(
          'Observed domain',
          domain,
          'Observed in submitted message; not independently verified'
        );
      });

      // Prefer the graph snapshot produced by the backend investigation.
      // This avoids a burst of extra FalkorDB traversals for every finding.
      const snapshot = savedCase.graph_snapshot;
      const snapshotNodes = Array.isArray(snapshot?.nodes) ? snapshot.nodes : [];
      const snapshotEdges = Array.isArray(snapshot?.edges) ? snapshot.edges : [];
      const targetIds = new Set<string>();
      findings.forEach((finding: any) => {
        if (typeof finding.connected_account_id === 'string') {
          targetIds.add(finding.connected_account_id);
        }
        if (typeof finding.report_id === 'string') {
          targetIds.add(finding.report_id);
        }
      });

      const domainNames: string[] = [...new Set<string>(
        findings
          .map((finding: any) => finding.domain)
          .filter((value: unknown): value is string =>
            typeof value === 'string' && value.trim().length > 0
          )
      )];

      const allNodes = new Map<string, any>();
      const allEdges = new Map<string, any>();
      const normalizeNode = (node: any) => {
        const props = node.properties || {};
        const id = String(node.id ?? props.id ?? '');
        if (id) allNodes.set(id, { ...node, id, properties: props });
      };
      const normalizeEdge = (edge: any) => {
        const from = String(edge.from ?? edge.source ?? '');
        const to = String(edge.to ?? edge.target ?? '');
        const type = String(edge.type ?? edge.label ?? 'CONNECTED_TO');
        if (from && to) allEdges.set(`${from}|${type}|${to}`, { ...edge, from, to, type });
      };

      // Snapshot records came from the backend's persisted FalkorDB traversal.
      for (const node of snapshotNodes) normalizeNode(node);
      for (const edge of snapshotEdges) normalizeEdge(edge);

      // Legacy cases may not have a snapshot. Fall back to just one bounded
      // traversal, rather than querying every discovered account separately.
      if (allNodes.size === 0 && targetIds.size > 0) {
        const id = [...targetIds][0];
        try {
          const response = await fetch(
            `/api/entities/${encodeURIComponent(id)}/graph?max_hops=2&limit=25`,
            { cache: 'no-store' }
          );
          if (response.ok) {
            const payload = await response.json();
            (payload.nodes || []).forEach(normalizeNode);
            (payload.edges || []).forEach(normalizeEdge);
          } else {
            console.warn('Legacy graph fallback returned:', response.status);
          }
        } catch (error) {
          console.warn('Legacy graph fallback failed:', error);
        }
      }

      // Resolve each hostname against the actual FalkorDB graph.
      // Account traversals are bounded subsets and may not include Domain nodes.
      if (domainNames.length > 0) {
        try {
          const graphResponse = await fetch('/api/graph', {
            cache: 'no-store'
          });

          if (graphResponse.ok) {
            const graphPayload = await graphResponse.json();
            const graphNodes = Array.isArray(graphPayload.nodes)
              ? graphPayload.nodes
              : [];

            for (const domainName of domainNames) {
              const domainNode = graphNodes.find((node: any) => {
                const props = node.properties || {};
                const labels = Array.isArray(node.labels) ? node.labels : [];
                const candidates = [
                  props.domain, props.name, props.hostname, props.url
                ];

                return labels.includes('Domain') && candidates.some(
                  (value: unknown) =>
                    typeof value === 'string' &&
                    value.trim().toLowerCase() === domainName.toLowerCase()
                );
              });

              const domainId = domainNode?.properties?.id;
              if (!domainId) {
                console.warn('Domain node not found in graph response:', domainName);
                continue;
              }

              try {
                const response = await fetch(
                  `/api/entities/${encodeURIComponent(String(domainId))}/graph?max_hops=2&limit=100`,
                  { cache: 'no-store' }
                );

                if (!response.ok) {
                  console.warn('Domain traversal returned:', response.status, domainId);
                  continue;
                }

                const payload = await response.json();

                for (const node of payload.nodes || []) {
                  const id = String(node.id ?? node.properties?.id ?? '');
                  if (id) allNodes.set(id, node);
                }

                for (const edge of payload.edges || []) {
                  const from = String(edge.from);
                  const to = String(edge.to);
                  const key = `${from}|${edge.type}|${to}`;
                  allEdges.set(key, edge);
                }
              } catch (error) {
                console.warn('Could not load domain traversal:', domainId, error);
              }
            }
          } else {
            console.warn('Could not resolve domain IDs:', graphResponse.status);
          }
        } catch (error) {
          console.warn('Could not resolve graph domains:', error);
        }
      }

      const nodes = [...allNodes.values()].map((node: any) => {
        const props = node.properties || {};
        const labels = Array.isArray(node.labels) ? node.labels : [];
        const type = labels.find((label: string) => label !== 'Entity')
          || node.type || 'Entity';

        return {
          id: String(node.id ?? props.id),
          type,
          name: String(
            props.name || props.username || props.domain ||
            props.hostname || props.url || props.id || type
          ),
          color: type === 'Account' ? 0x3B82F6
            : type === 'Domain' || type === 'ObservedDomain' ? 0xF59E0B
            : type === 'Report' ? 0xEF4444
            : 0x94A3B8
        };
      });

      // Keep the observed domain visible even when traversal finds no matches.
      for (const domain of extractedDomainsForDisplay) {
        const exists = nodes.some((node: any) =>
          String(node.name).toLowerCase() === domain.toLowerCase()
        );

        if (!exists) {
          nodes.push({
            id: `observed:${domain}`,
            type: 'ObservedDomain',
            name: domain,
            color: 0xF59E0B
          });
        }
      }

      const nodeIds = new Set(nodes.map((node: any) => node.id));
      const edges = [...allEdges.values()]
        .map((edge: any) => ({
          source: String(edge.from),
          target: String(edge.to),
          label: String(edge.type || 'CONNECTED_TO')
        }))
        .filter((edge: any) =>
          nodeIds.has(edge.source) && nodeIds.has(edge.target)
        );

      console.log('[VEYRA DEBUG] Final display data:', {
        entityCount: entities.length,
        entitiesSample: entities.slice(0, 10),
        nodeCount: nodes.length,
        nodeSample: nodes.slice(0, 10),
        edgeCount: edges.length,
        edgeSample: edges.slice(0, 10),
        domains: extractedDomainsForDisplay
      });

      setActiveStage(6);
      setCaseData({
        caseId,
        confidence: 'Not scored',
        risk: String(
          savedCase.status || finalStatus || 'Assessment pending'
        ).replaceAll('_', ' '),
        summary: String(
          savedCase.assessment
          || savedCase.initial_assessment
          || submitted.assessment
          || 'Investigation finished. Review the saved findings before drawing conclusions.'
        ),
        entities,
        remediation: (() => {
          const warningIndicators = Array.isArray(submitted.indicators)
            ? submitted.indicators : [];
          const hasConnectedEvidence = findings.length > 0 || nodes.length > 0;
          const hasWarning = warningIndicators.length > 0;
          if (finalStatus === 'investigation_failed') return {
            action: 'Review investigation failure',
            reason: 'The investigation did not complete. Do not message, block, or label the account based on incomplete results.',
            confidence: 'Unavailable'
          };
          if (hasWarning || hasConnectedEvidence) return {
            action: 'Check this account before messaging',
            reason: hasWarning
              ? 'This message contains warning signs. Avoid sharing personal information or clicking links until you have checked whether the sender is genuine.'
              : 'VEYRA found related records, but that alone does not mean this account is dangerous. Check the evidence before messaging or blocking.',
            confidence: 'Not scored'
          };
          return {
            action: "We could not verify whether this account is safe",
            reason: "We did not find enough evidence to decide. This does not prove the account is safe or unsafe. Verify the sender through an independent, trusted channel before replying.",
            confidence: 'Insufficient evidence'
          };
        })(),
        graphData: { nodes, edges }
      });

      setWorkflowState(
        finalStatus === 'needs_review' || finalStatus === 'completed'
          ? 'completed'
          : 'failed'
      );
    } catch (error) {
      console.error('Veyra investigation failed:', error);
      setWorkflowState('failed');
      setCaseData(prev => prev ? {
        ...prev,
        summary: error instanceof Error
          ? error.message
          : 'The investigation could not be completed.'
      } : prev);
    }
  };

  // 3D Graph Initialization
  useEffect(() => {
    if (workflowState === 'idle' || !caseData?.graphData?.nodes?.length || !graphContainerRef.current) return;

    let renderer: any, scene: any, camera: any, animationFrameId: number | undefined;

    const initGraph = async () => {
      const container = graphContainerRef.current;
      if (!container) return;
      if (!window.THREE) {
        await new Promise((resolve) => {
          const script = document.createElement('script');
          script.src = 'https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js';
          script.onload = resolve;
          document.head.appendChild(script);
        });
      }

      const THREE = window.THREE;
      if (!THREE) throw new Error('Three.js failed to load.');
      const width = container.clientWidth;
      const height = container.clientHeight;

      if (width <= 0 || height <= 0) {
        console.error('Veyra graph container has no visible dimensions.', {
          width, height
        });
        container.innerHTML =
          '<div style="padding:24px;color:#F59E0B;font:14px monospace">Graph container has no visible dimensions. Reopen the investigation.</div>';
        return;
      }

      scene = new THREE.Scene();
      scene.background = new THREE.Color(0x070709); 

      camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
      camera.position.set(0, 0, 4);

      renderer = new THREE.WebGLRenderer({ antialias: true, alpha: false });
      renderer.setSize(width, height);
      renderer.setClearColor(0x070709, 1);
      
      container.innerHTML = '';
      container.appendChild(renderer.domElement);

      scene.add(new THREE.AmbientLight(0xffffff, 2));
      const dirLight = new THREE.DirectionalLight(0xffffff, 1.5);
      dirLight.position.set(5, 10, 7);
      scene.add(dirLight);

      const group = new THREE.Group();
      scene.add(group);

      const nodeMeshes: Record<string, any> = {};
      const totalNodes = caseData.graphData.nodes.length;
      const radius = Math.max(0.8, Math.min(2.2, totalNodes * 0.12));

      caseData.graphData.nodes.forEach((n, idx) => {
        const angle = (idx / Math.max(totalNodes, 1)) * Math.PI * 2;
        const vertical = ((idx % 3) - 1) * 0.35;
        const pos = [
          Math.cos(angle) * radius,
          Math.sin(angle) * radius * 0.65 + vertical,
          Math.sin(angle * 2) * 0.45
        ];
        const geo = new THREE.SphereGeometry(0.18, 32, 32);
        const mat = new THREE.MeshStandardMaterial({
          color: n.color,
          roughness: 0.2,
          metalness: 0.8,
          emissive: n.color,
          emissiveIntensity: 0.5
        });
        const mesh = new THREE.Mesh(geo, mat);
        mesh.position.set(...pos);
        mesh.userData = n;
        group.add(mesh);
        nodeMeshes[n.id] = mesh;
      });

      caseData.graphData.edges.forEach((e) => {
        const src = nodeMeshes[e.source];
        const tgt = nodeMeshes[e.target];
        if (src && tgt) {
          const lineGeo = new THREE.BufferGeometry().setFromPoints([src.position, tgt.position]);
          const lineMat = new THREE.LineBasicMaterial({ color: 0xFFCC00, transparent: true, opacity: 0.6 });
          const line = new THREE.Line(lineGeo, lineMat);
          group.add(line);
        }
      });

      const raycaster = new THREE.Raycaster();
      const mouse = new THREE.Vector2();
      const onClick = (event: MouseEvent) => {
        const rect = renderer.domElement.getBoundingClientRect();
        mouse.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
        mouse.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;
        raycaster.setFromCamera(mouse, camera);
        const intersects = raycaster.intersectObjects(group.children);
        if (intersects.length > 0 && intersects[0].object.userData?.id) {
          setSelectedNode(intersects[0].object.userData);
        }
      };
      
      let isDragging = false;
      let previousMousePosition = { x: 0, y: 0 };
      
      renderer.domElement.addEventListener('mousedown', () => isDragging = true);
      renderer.domElement.addEventListener('mouseup', () => isDragging = false);
      renderer.domElement.addEventListener('mousemove', (e: MouseEvent) => {
        if (isDragging) {
          const deltaMove = { x: e.offsetX - previousMousePosition.x, y: e.offsetY - previousMousePosition.y };
          group.rotation.y += deltaMove.x * 0.005;
          group.rotation.x += deltaMove.y * 0.005;
        }
        previousMousePosition = { x: e.offsetX, y: e.offsetY };
      });
      
      renderer.domElement.addEventListener('click', onClick);

      const animate = () => {
        animationFrameId = requestAnimationFrame(animate);
        if (!isDragging) {
            group.rotation.y += 0.002;
        }
        renderer.render(scene, camera);
      };
      
      setGraphReady(true);
      animate();
    };

    initGraph();

    return () => {
      if (animationFrameId) cancelAnimationFrame(animationFrameId);
      if (renderer && renderer.domElement) renderer.dispose();
    };
  }, [workflowState, caseData]);

  return (
    <div className="relative min-h-full w-full bg-[#070709] text-slate-200 font-sans overflow-x-hidden m-0 p-0 selection:bg-[#FFCC00] selection:text-black">
      
      {/* Investigation Header */}
      <header className="sticky top-0 z-50 flex items-center justify-between px-6 lg:px-10 py-5 border-b border-white/5 bg-[#070709]/90 backdrop-blur-md shrink-0">
        <div>
          <h1 className="text-xl lg:text-2xl font-extrabold text-white tracking-tight flex items-center gap-3">
            Investigation Workspace
            {workflowState !== 'idle' && (
              <span className={`text-[10px] font-mono font-bold px-2.5 py-1 rounded border ${
                workflowState === 'running' ? 'bg-[#FFCC00]/10 text-[#FFCC00] border-[#FFCC00]/30 animate-pulse' :
                workflowState === 'completed' ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30' :
                'bg-red-500/10 text-red-400 border-red-500/30'
              }`}>
                {workflowState.toUpperCase()} {caseData?.caseId && `• ${caseData.caseId}`}
              </span>
            )}
          </h1>
          <p className="text-xs text-slate-400 mt-1">Investigate suspicious activity through connected evidence.</p>
        </div>
        <div>
          {workflowState !== 'idle' && (
            <button 
              onClick={() => onClose ? onClose() : window.location.reload()} 
              className="px-4 py-2 rounded-lg bg-white/5 hover:bg-white/10 border border-white/10 text-white font-bold text-xs transition-colors"
            >
              New Investigation
            </button>
          )}
        </div>
      </header>

      <main className="w-full max-w-6xl mx-auto p-6 lg:p-10 flex flex-col gap-8 pb-20">
        
        {/* Mode B Input Form (Shown only when opened from tab and idle) */}
        {workflowState === 'idle' && entryMode === 'B' && (
          <div className="bg-[#101015] border border-white/5 rounded-xl p-6 shadow-2xl flex flex-col gap-4">
            <div className="flex flex-col gap-1.5">
              <label className="text-[10px] font-mono text-slate-400 font-bold uppercase tracking-wider">Investigation Question / Incident Description</label>
              <textarea
                value={investigationQuery}
                onChange={(e) => setInvestigationQuery(e.target.value)}
                placeholder="Type or paste the suspicious message / question here (e.g. Investigate whether this account is connected to phishing domains...)"
                className="w-full bg-[#070709] border border-white/10 rounded-lg p-4 text-sm text-white focus:border-[#FFCC00] focus:ring-1 focus:ring-[#FFCC00] focus:outline-none resize-none h-28 transition-all"
                required
              />
            </div>

            <details className="group cursor-pointer">
              <summary className="text-[11px] text-[#FFCC00] font-bold select-none flex items-center gap-2 outline-none">
                <span className="transition-transform group-open:rotate-90">▶</span>
                Show Advanced Parameters (Suspect ID, Domain, Context)
              </summary>
              <div className="grid grid-cols-1 md:grid-cols-2 gap-4 pt-4 mt-2 border-t border-white/5">
                <div className="flex flex-col gap-1.5">
                  <label className="text-[10px] font-mono text-slate-400 font-bold uppercase">Suspect ID</label>
                  <input type="text" value={suspectId} onChange={(e)=>setSuspectId(e.target.value)} className="bg-[#070709] border border-white/10 rounded-lg p-2.5 text-xs text-white focus:border-[#FFCC00] outline-none transition-all" />
                </div>
                <div className="flex flex-col gap-1.5">
                  <label className="text-[10px] font-mono text-slate-400 font-bold uppercase">Target Domain / URL</label>
                  <input type="text" value={targetUrl} onChange={(e)=>setTargetUrl(e.target.value)} className="bg-[#070709] border border-white/10 rounded-lg p-2.5 text-xs text-white focus:border-[#FFCC00] outline-none transition-all" />
                </div>
              </div>
            </details>

            <div className="flex justify-end mt-4">
              <button
                onClick={startInvestigation}
                disabled={!investigationQuery.trim()}
                className={`px-6 py-2.5 font-extrabold text-xs rounded-lg shadow-lg transition-all ${
                  investigationQuery.trim() 
                    ? 'bg-[#FFCC00] hover:bg-[#e6b800] text-black shadow-[#FFCC00]/10 cursor-pointer' 
                    : 'bg-white/5 text-slate-500 cursor-not-allowed shadow-none border border-white/10'
                }`}
              >
                Proceed & Investigate with Veyra →
              </button>
            </div>
          </div>
        )}

        {/* Live Execution Stepper (Active in Mode A instantly or Mode B after clicking proceed) */}
        {workflowState !== 'idle' && (
          <div className="bg-[#101015] border border-white/5 rounded-xl p-6 shadow-2xl flex flex-col gap-6 animate-in fade-in">
            <h3 className="text-white font-bold text-sm flex items-center gap-2">
              <span className={`w-2 h-2 rounded-full ${workflowState === 'running' ? 'bg-[#FFCC00] animate-ping' : 'bg-emerald-500'}`}></span>
              Live Execution Workflow {entryMode === 'A' && '• Started directly from DM'}
            </h3>
            
            <div className="relative flex items-center justify-between w-full overflow-hidden px-2 pb-2">
              {stages.map((stage, index) => {
                const stageNum = stage.id;
                const isCompleted = activeStage > stageNum || workflowState === 'completed';
                const isRunning = activeStage === stageNum && workflowState === 'running';
                
                return (
                  <React.Fragment key={stage.id}>
                    <div className="flex flex-col items-center gap-2 relative z-10 min-w-[80px]">
                      <div className={`w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold transition-all duration-500 ${
                        isCompleted ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/50' :
                        isRunning ? 'bg-[#FFCC00]/20 text-[#FFCC00] border border-[#FFCC00] shadow-[0_0_15px_rgba(255,204,0,0.3)] scale-110' :
                        'bg-[#070709] border border-white/10 text-slate-500'
                      }`}>
                        {isCompleted ? <CheckIcon /> : stageNum}
                      </div>
                      <span className={`text-[10px] font-mono text-center whitespace-nowrap ${
                        isRunning ? 'text-[#FFCC00] font-bold' : isCompleted ? 'text-slate-300' : 'text-slate-600'
                      }`}>
                        {stage.name}
                      </span>
                    </div>

                    {index < stages.length - 1 && (
                      <div className="flex-1 h-[2px] mx-2 relative bg-white/5 overflow-hidden rounded-full">
                        <div className={`absolute top-0 left-0 h-full transition-all duration-700 ${
                          isCompleted ? 'w-full bg-emerald-500/50' : 
                          isRunning ? 'w-full bg-gradient-to-r from-transparent via-[#FFCC00] to-transparent animate-[shimmer_1.5s_infinite]' : 
                          'w-0 bg-transparent'
                        }`}></div>
                      </div>
                    )}
                  </React.Fragment>
                );
              })}
            </div>
            
            <style>{`
              @keyframes shimmer {
                0% { transform: translateX(-100%); }
                100% { transform: translateX(100%); }
              }
            `}</style>

        {/* Live FalkorDB multi-hop execution console */}
        <section className="mt-2 overflow-hidden rounded-2xl border border-white/10 bg-[#09090d]">
          <div className="flex flex-wrap items-center justify-between gap-3 border-b border-white/10 px-5 py-4">
            <div>
              <p className="text-[10px] font-mono uppercase tracking-[0.24em] text-yellow-400">
                VEYRA / Runtime
              </p>
              <h2 className="mt-1 text-lg font-bold text-white">
                Multi-hop query execution
              </h2>
              <p className="mt-1 text-xs text-slate-400">
                Live events received from the investigation backend
              </p>
            </div>
            <span className={`rounded-full border px-3 py-1 text-[10px] font-mono uppercase ${
              workflowState === "running"
                ? "border-yellow-400/30 bg-yellow-400/10 text-yellow-300"
                : workflowState === "completed"
                  ? "border-emerald-400/30 bg-emerald-400/10 text-emerald-300"
                  : "border-white/10 bg-white/5 text-slate-400"
            }`}>
              {workflowState}
            </span>
          </div>

          <div className="grid grid-cols-2 gap-px border-b border-white/10 bg-white/10 md:grid-cols-4">
            <div className="bg-[#0b0b10] p-4">
              <p className="text-[10px] uppercase tracking-wider text-slate-500">Query events</p>
              <p className="mt-2 text-2xl font-semibold text-white">{queryEvents.length}</p>
            </div>
            <div className="bg-[#0b0b10] p-4">
              <p className="text-[10px] uppercase tracking-wider text-slate-500">Hops observed</p>
              <p className="mt-2 text-2xl font-semibold text-white">
                {new Set(queryEvents.map((event: any) => event.hop).filter((hop: any) => hop != null)).size}
              </p>
            </div>
            <div className="bg-[#0b0b10] p-4">
              <p className="text-[10px] uppercase tracking-wider text-slate-500">Rows returned</p>
              <p className="mt-2 text-2xl font-semibold text-white">
                {queryEvents.reduce((sum: number, event: any) => sum + (Number(event.rows_returned) || 0), 0)}
              </p>
            </div>
            <div className="bg-[#0b0b10] p-4">
              <p className="text-[10px] uppercase tracking-wider text-slate-500">Query failures</p>
              <p className="mt-2 text-2xl font-semibold text-red-300">
                {queryEvents.filter((event: any) => event.stage === "query_failed").length}
              </p>
            </div>
          </div>

          <div className="flex items-center justify-between border-b border-white/10 px-5 py-3">
            <h3 className="text-xs font-bold text-slate-200">Execution timeline</h3>
            <span className="text-[10px] text-slate-500">Newest events appear as backend progress is polled</span>
          </div>

          <div className="max-h-[680px] overflow-y-auto">
            {queryEvents.length === 0 ? (
              <div className="p-8 text-center">
                <div className={`mx-auto mb-3 h-3 w-3 rounded-full ${
                  workflowState === "running"
                    ? "animate-pulse bg-yellow-400"
                    : "bg-slate-600"
                }`} />
                <p className="text-sm font-medium text-white">
                  {workflowState === "running"
                    ? "Waiting for the first query event"
                    : "No query events recorded for this case"}
                </p>
                <p className="mx-auto mt-2 max-w-lg text-xs leading-5 text-slate-500">
                  This panel displays actual persisted FalkorDB execution events. It does not generate placeholder queries or simulated hop results.
                </p>
              </div>
            ) : (
              <div className="divide-y divide-white/5">
                {queryEvents.map((event: any, index: number) => (
                  <article
                    key={`${event.timestamp || "event"}-${index}`}
                    className="px-5 py-4 transition-colors hover:bg-white/[0.02]"
                  >
                    <div className="flex flex-wrap items-center justify-between gap-3">
                      <div className="flex items-center gap-3">
                        <span className={`flex h-8 min-w-8 items-center justify-center rounded-lg border px-2 text-xs font-bold ${
                          event.stage === "query_failed"
                            ? "border-red-400/30 bg-red-400/10 text-red-300"
                            : event.stage === "query_completed" || event.stage === "traversal_completed"
                              ? "border-emerald-400/30 bg-emerald-400/10 text-emerald-300"
                              : "border-yellow-400/30 bg-yellow-400/10 text-yellow-300"
                        }`}>
                          {event.hop != null ? `H${event.hop}` : "·"}
                        </span>
                        <div>
                          <p className="text-xs font-bold uppercase tracking-wider text-white">
                            {String(event.stage || "event").replaceAll("_", " ")}
                          </p>
                          <p className="mt-1 text-[10px] text-slate-500">
                            {event.timestamp || "Timestamp unavailable"}
                          </p>
                        </div>
                      </div>
                      <div className="flex flex-wrap gap-2 text-[10px] font-mono text-slate-400">
                        {event.elapsed_ms != null && <span className="rounded border border-white/10 px-2 py-1">{event.elapsed_ms} ms</span>}
                        {event.rows_returned != null && <span className="rounded border border-white/10 px-2 py-1">{event.rows_returned} rows</span>}
                        {event.node_count != null && <span className="rounded border border-white/10 px-2 py-1">{event.node_count} nodes</span>}
                        {event.edge_count != null && <span className="rounded border border-white/10 px-2 py-1">{event.edge_count} edges</span>}
                      </div>
                    </div>

                    <p className="mt-3 break-words text-xs leading-5 text-slate-300">
                      {event.message || "Backend event received."}
                    </p>

                    {event.start_id && (
                      <p className="mt-2 break-all font-mono text-[10px] text-slate-500">
                        START ENTITY / {event.start_id}
                      </p>
                    )}

                    {event.query && (
                      <details className="mt-3 overflow-hidden rounded-lg border border-white/10 bg-black/30">
                        <summary className="cursor-pointer px-3 py-3 text-xs font-medium text-yellow-300">
                          View executed Cypher
                        </summary>
                        <div className="border-t border-white/10 p-3">
                          <QueryTypewriter text={String(event.query)} />
                        </div>
                      </details>
                    )}

                    {event.parameters && (
                      <details className="mt-2 overflow-hidden rounded-lg border border-white/10 bg-black/30">
                        <summary className="cursor-pointer px-3 py-3 text-xs text-slate-300">
                          View query parameters
                        </summary>
                        <pre className="overflow-x-auto whitespace-pre-wrap break-words border-t border-white/10 p-3 text-[11px] leading-5 text-slate-400">
                          {JSON.stringify(event.parameters, null, 2)}
                        </pre>
                      </details>
                    )}

                    {event.error && (
                      <p className="mt-3 break-words rounded-lg border border-red-400/20 bg-red-400/5 p-3 text-xs text-red-300">
                        {event.error}
                      </p>
                    )}
                  </article>
                ))}
              </div>
            )}
          </div>
        </section>

          </div>
        )}


      </main>
    </div>
  );
}
