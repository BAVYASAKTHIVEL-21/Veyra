import GraphExplorer from "./GraphExplorer";
import { useEffect, useState } from "react";
import Landing from "./Landing";
import {
  Activity,
  AlertTriangle,
  ArrowUpRight,
  ChevronRight,
  CircleDot,
  Clock3,
  Globe2,
  LayoutDashboard,
  LoaderCircle,
  Network,
  RefreshCw,
  Send,
  Shield,
  ShieldCheck,
  Users,
  XCircle,
} from "lucide-react";
import "./App.css";
import InvestigationWorkspace from "./InvestigationWorkspace";

type GraphNode = {
  labels: string[];
  properties: Record<string, unknown>;
};

type GraphEdge = {
  from_labels: string[];
  from: Record<string, unknown>;
  relationship: string;
  to_labels: string[];
  to: Record<string, unknown>;
};

type CaseRecord = {
  id: string;
  status: string;
  source?: string;
  created_at?: string;
  assessment?: string;
  initial_assessment?: string;
  findings?: Array<{
    domain?: string | null;
    connected_account_id?: string | null;
    report_id?: string | null;
  }>;
  indicators?: Array<{
    type: string;
    description: string;
    matched_terms?: string[];
  }>;
  observed_domains?: string[];
  message_id?: string;
  error?: string;
};

type View = "overview" | "inbox" | "graph" | "cases" | "investigation";

const API = "";

function getErrorMessage(error: unknown) {
  return error instanceof Error ? error.message : "Something went wrong.";
}

async function api<T>(
  path: string,
  options?: RequestInit,
  timeoutMs = 8000,
): Promise<T> {
  const controller = new AbortController();
  const timeout = window.setTimeout(() => controller.abort(), timeoutMs);

  try {
    const response = await fetch(`${API}${path}`, {
      ...options,
      signal: controller.signal,
      headers: {
        "Content-Type": "application/json",
        ...options?.headers,
      },
    });

    if (!response.ok) {
      const body = await response.text();
      throw new Error(body || `Request failed: ${response.status}`);
    }

    return await response.json() as T;
  } catch (error) {
    if (error instanceof Error && error.name === "AbortError") {
      throw new Error(`${path} timed out after ${timeoutMs / 1000}s`);
    }
    throw error;
  } finally {
    window.clearTimeout(timeout);
  }
}

function formatDate(value?: string) {
  if (!value) return "—";
  const date = new Date(value);
  return Number.isNaN(date.getTime())
    ? value
    : date.toLocaleString();
}

function App() {
  const [view, setView] = useState<View>("overview");
  const [showLanding, setShowLanding] = useState(true);
  const [backendOnline, setBackendOnline] = useState(false);
  const [graphNodes, setGraphNodes] = useState<GraphNode[]>([]);
  const [graphEdges, setGraphEdges] = useState<GraphEdge[]>([]);
  const [cases, setCases] = useState<CaseRecord[]>([]);
  const [selectedCase, setSelectedCase] = useState<CaseRecord | null>(null);
  const [message, setMessage] = useState("");
  const [senderId, setSenderId] = useState("");
  const [submitting, setSubmitting] = useState(false);
  const [loadingGraph, setLoadingGraph] = useState(false);
  const [loadingCase, setLoadingCase] = useState(false);
  const [error, setError] = useState("");

  async function refreshHealth() {
    try {
      await api("/api/health");
      setBackendOnline(true);
    } catch {
      setBackendOnline(false);
    }
  }

  async function refreshGraph() {
    const cacheKey = "veyra:graph:v1";
    let hasCachedGraph = false;

    // Render the last graph immediately while fetching fresh data.
    try {
      const cached = localStorage.getItem(cacheKey);
      if (cached) {
        const data = JSON.parse(cached);
        if (Array.isArray(data.nodes) && Array.isArray(data.edges)) {
          setGraphNodes(data.nodes);
          setGraphEdges(data.edges);
          hasCachedGraph = true;
        }
      }
    } catch {
      // Ignore malformed or unavailable browser cache.
    }

    if (!hasCachedGraph) setLoadingGraph(true);

    try {
      const data = await api<{
        nodes: GraphNode[];
        edges: GraphEdge[];
      }>("/api/graph", undefined, 20000);

      const nodes = data.nodes || [];
      const edges = data.edges || [];

      setGraphNodes(nodes);
      setGraphEdges(edges);

      try {
        localStorage.setItem(
          cacheKey,
          JSON.stringify({ nodes, edges, cachedAt: Date.now() }),
        );
      } catch {
        // Storage may be full or disabled; live graph still works.
      }

      setError("");
    } catch (err) {
      if (!hasCachedGraph) {
        setError(`Graph could not load: ${getErrorMessage(err)}`);
      }
    } finally {
      setLoadingGraph(false);
    }
  }

  async function refreshCase(caseId: string) {
    setLoadingCase(true);
    try {
      const result = await api<CaseRecord>(
        `/api/cases/${encodeURIComponent(caseId)}`,
      );

      setSelectedCase(result);
      setCases((previous) => [
        result,
        ...previous.filter((item) => item.id !== result.id),
      ]);
      setError("");
    } catch (err) {
      setError(`Case could not load: ${getErrorMessage(err)}`);
    } finally {
      setLoadingCase(false);
    }
  }

  async function submitMessage(event: React.FormEvent<HTMLFormElement>) {
    event.preventDefault();
    if (!message.trim()) return;

    setSubmitting(true);
    setError("");

    try {
      const result = await api<CaseRecord>("/api/messages/analyze", {
        method: "POST",
        body: JSON.stringify({
          message: message.trim(),
          source: "user_submission",
          ...(senderId.trim()
            ? { sender_account_id: senderId.trim() }
            : {}),
        }),
      });

      setMessage("");
      setSenderId("");
      setSelectedCase(result);
      setCases((previous) => [
        result,
        ...previous.filter((item) => item.id !== result.id),
      ]);
      setView("inbox");

      // The investigation runs in the backend. Refresh the case to get
      // the completed findings without blocking initial message submission.
      window.setTimeout(() => {
        void refreshCase(result.id);
      }, 1200);
    } catch (err) {
      setError(`Message submission failed: ${getErrorMessage(err)}`);
    } finally {
      setSubmitting(false);
    }
  }

  useEffect(() => {
    void refreshHealth();
    void refreshGraph();

    const healthTimer = window.setInterval(() => {
      void refreshHealth();
    }, 15000);

    return () => window.clearInterval(healthTimer);
  }, []);

  useEffect(() => {
    if (!selectedCase?.id) return;

    if (
      selectedCase.status === "investigating" ||
      selectedCase.status === "received"
    ) {
      const timer = window.setInterval(() => {
        void refreshCase(selectedCase.id);
      }, 2000);

      return () => window.clearInterval(timer);
    }
  }, [selectedCase?.id, selectedCase?.status]);

  const accountNodes = graphNodes.filter((node) =>
    node.labels.includes("Account"),
  );
  const domainNodes = graphNodes.filter(
    (node) =>
      node.labels.includes("Domain") ||
      node.labels.includes("ObservedDomain"),
  );
  const reportNodes = graphNodes.filter((node) =>
    node.labels.includes("Report"),
  );

  const navigation = [
    { id: "overview" as const, label: "Overview", icon: LayoutDashboard },
    { id: "inbox" as const, label: "Message analysis", icon: ShieldCheck },
    { id: "cases" as const, label: "Investigation cases", icon: Activity },
    { id: "graph" as const, label: "Graph explorer", icon: Network },
    { id: "investigation" as const, label: "Investigation workspace", icon: ShieldCheck },
  ];

  function statusClass(status?: string) {
    if (status === "needs_review") return "status-review";
    if (status === "completed") return "status-complete";
    if (status === "investigation_failed") return "status-failed";
    return "status-pending";
  }

  function renderCaseDetails(record: CaseRecord) {
    return (
      <section className="panel case-detail" key={record.id}>
        <div className="panel-heading">
          <div>
            <span className="eyebrow">CASE INVESTIGATION</span>
            <h2>Case details</h2>
          </div>
          <button
            className="icon-button"
            onClick={() => void refreshCase(record.id)}
            title="Refresh case"
          >
            {loadingCase ? (
              <LoaderCircle className="spin" size={17} />
            ) : (
              <RefreshCw size={17} />
            )}
          </button>
        </div>

        <p className="case-id">{record.id}</p>

        <div className="case-status-row">
          <span className={`status-pill ${statusClass(record.status)}`}>
            <CircleDot size={13} />
            {record.status?.replaceAll("_", " ") || "unknown"}
          </span>
          <span className="muted small">
            {formatDate(record.created_at)}
          </span>
        </div>

        <div className="assessment">
          <ShieldCheck size={19} />
          <div>
            <strong>Assessment</strong>
            <p>
              {record.assessment ||
                record.initial_assessment ||
                "No assessment is available yet."}
            </p>
          </div>
        </div>

        {record.indicators && record.indicators.length > 0 && (
          <>
            <h3>Initial warning indicators</h3>
            {record.indicators.map((indicator, index) => (
              <div className="finding-row" key={`${indicator.type}-${index}`}>
                <AlertTriangle size={17} />
                <div>
                  <strong>
                    {indicator.type.replaceAll("_", " ")}
                  </strong>
                  <p>{indicator.description}</p>
                  {indicator.matched_terms?.length ? (
                    <span className="muted small">
                      Matched: {indicator.matched_terms.join(", ")}
                    </span>
                  ) : null}
                </div>
              </div>
            ))}
          </>
        )}

        <h3>Connected evidence</h3>
        {record.findings?.length ? (
          record.findings.map((finding, index) => (
            <div className="finding-row" key={`${finding.domain}-${index}`}>
              <Globe2 size={17} />
              <div>
                <strong>{finding.domain || "Related graph record"}</strong>
                <p>
                  Account: {finding.connected_account_id || "Not linked"}
                </p>
                <p>Report: {finding.report_id || "No linked report"}</p>
              </div>
            </div>
          ))
        ) : (
          <p className="muted">
            No connected findings returned yet. The absence of findings does
            not prove that a message is safe.
          </p>
        )}

        {record.error && (
          <div className="error-box">
            <XCircle size={17} />
            {record.error}
          </div>
        )}
      </section>
    );
  }


  if (showLanding) {
    return (
      <Landing
        onGetStarted={() => setShowLanding(false)}
      />
    );
  }

  return (
    <div className="app-shell">

      <aside className="sidebar">
        <button className="brand" onClick={() => setView("overview")}>
          <span className="brand-icon">
            <Shield size={23} />
          </span>
          <span>
            <strong>VEYRA</strong>
            <small>INTELLIGENCE</small>
          </span>
        </button>

        <div className="nav-label">WORKSPACE</div>
        <nav className="navigation">
          {navigation.map(({ id, label, icon: Icon }) => (
            <button
              key={id}
              className={`nav-item ${view === id ? "active" : ""}`}
              onClick={() => setView(id)}
            >
              <Icon size={18} />
              <span>{label}</span>
              {view === id && <ChevronRight size={15} />}
            </button>
          ))}
        </nav>

        <div className="sidebar-bottom">
          <div className="connection-card">
            <span className={`connection-dot ${backendOnline ? "online" : ""}`} />
            <div>
              <strong>API connection</strong>
              <small>{backendOnline ? "Backend connected" : "Backend unavailable"}</small>
            </div>
          </div>
          <p className="sidebar-caption">
            Evidence intelligence
            <br />
            Built for connected investigations
          </p>
        </div>
      </aside>

      <main className="main-content">
        <header className="topbar">
          <div className="breadcrumbs">
            <span>Workspace</span>
            <ChevronRight size={14} />
            <strong>
              {navigation.find((item) => item.id === view)?.label}
            </strong>
          </div>
          <div className="topbar-right">
            <span className={`live-indicator ${backendOnline ? "online" : ""}`} />
            <span>{backendOnline ? "API online" : "API offline"}</span>
            <button
              className="icon-button"
              title="Refresh backend and graph"
              onClick={() => {
                void refreshHealth();
                void refreshGraph();
              }}
            >
              <RefreshCw size={16} />
            </button>
          </div>
        </header>

        <div className="page-content">
          {error && (
            <div className="error-banner">
              <AlertTriangle size={17} />
              <span>{error}</span>
              <button onClick={() => setError("")} aria-label="Dismiss error">
                <XCircle size={17} />
              </button>
            </div>
          )}

          {view === "overview" && (
            <>
              <section className="page-title">
                <div>
                  <span className="eyebrow">THREAT INTELLIGENCE WORKSPACE</span>
                  <h1>Good to see you.</h1>
                  <p>
                    Investigate suspicious activity through connected evidence.
                  </p>
                </div>
                <button className="primary-button" onClick={() => setView("inbox")}>
                  <ShieldCheck size={17} />
                  Analyze a message
                </button>
              </section>

              <section className="metrics-grid">
                <Metric
                  icon={<Users size={19} />}
                  label="Accounts"
                  value={loadingGraph ? "…" : accountNodes.length}
                  note="Account nodes in graph"
                />
                <Metric
                  icon={<Globe2 size={19} />}
                  label="Domains"
                  value={loadingGraph ? "…" : domainNodes.length}
                  note="Known and observed domains"
                />
                <Metric
                  icon={<Activity size={19} />}
                  label="Reports"
                  value={loadingGraph ? "…" : reportNodes.length}
                  note="Report nodes in graph"
                />
                <Metric
                  icon={<ShieldCheck size={19} />}
                  label="Cases this session"
                  value={cases.length}
                  note="Cases opened in this UI session"
                />
              </section>

              <section className="content-grid">
                <div className="panel welcome-panel">
                  <div className="hero-icon">
                    <ShieldCheck size={29} />
                  </div>
                  <span className="eyebrow">CONNECTED EVIDENCE</span>
                  <h2>One message can reveal a wider network.</h2>
                  <p>
                    Analyze a message, discover connected domains and accounts,
                    and inspect evidence recorded in FalkorDB.
                  </p>
                  <button
                    className="primary-button"
                    onClick={() => setView("inbox")}
                  >
                    Start an investigation <ArrowUpRight size={17} />
                  </button>
                </div>

                <div className="panel">
                  <div className="panel-heading">
                    <div>
                      <span className="eyebrow">SYSTEM STATUS</span>
                      <h2>Services</h2>
                    </div>
                    <button
                      className="icon-button"
                      onClick={() => void refreshHealth()}
                      title="Refresh status"
                    >
                      <RefreshCw size={16} />
                    </button>
                  </div>
                  <ServiceRow
                    name="FastAPI"
                    detail="Message and case endpoints"
                    online={backendOnline}
                  />
                  <ServiceRow
                    name="FalkorDB"
                    detail="Graph database connection"
                    online={backendOnline}
                  />
                  <ServiceRow
                    name="Graph data"
                    detail={`${graphNodes.length} nodes · ${graphEdges.length} edges returned`}
                    online={backendOnline && !loadingGraph}
                  />
                  <p className="muted small service-note">
                    Database status reflects the backend health endpoint; graph
                    counts reflect the latest API response.
                  </p>
                </div>
              </section>

              <section className="panel">
                <div className="panel-heading">
                  <div>
                    <span className="eyebrow">RECENT ACTIVITY</span>
                    <h2>Cases opened in this session</h2>
                  </div>
                  <button className="text-button" onClick={() => setView("cases")}>
                    View cases <ChevronRight size={15} />
                  </button>
                </div>
                {cases.length ? (
                  <CaseList cases={cases} onSelect={refreshCase} statusClass={statusClass} />
                ) : (
                  <EmptyState
                    title="No cases opened in this session"
                    detail="Submit a message to create your first case."
                    action="Analyze a message"
                    onClick={() => setView("inbox")}
                  />
                )}
              </section>
            </>
          )}

          {view === "inbox" && (
            <>
              <section className="page-title">
                <div>
                  <span className="eyebrow">MESSAGE INTAKE</span>
                  <h1>Analyze a message</h1>
                  <p>
                    Submit message content for immediate checks and graph
                    investigation.
                  </p>
                </div>
              </section>

              <section className="content-grid inbox-grid">
                <form className="panel message-form" onSubmit={submitMessage}>
                  <div className="panel-heading">
                    <div>
                      <span className="eyebrow">NEW INVESTIGATION</span>
                      <h2>Incoming message</h2>
                    </div>
                    <ShieldCheck size={22} />
                  </div>
                  <label htmlFor="message">Message content</label>
                  <textarea
                    id="message"
                    value={message}
                    onChange={(event) => setMessage(event.target.value)}
                    placeholder="Paste the message here, including any links…"
                    maxLength={10000}
                    required
                    rows={7}
                  />
                  <label htmlFor="sender">Known sender account ID (optional)</label>
                  <input
                    id="sender"
                    value={senderId}
                    onChange={(event) => setSenderId(event.target.value)}
                    placeholder="e.g. acct_friend_002"
                  />
                  <p className="muted small">
                    Only provide an account ID that already exists in your
                    graph. The backend does not verify message authenticity.
                  </p>
                  <button
                    className="primary-button full-width"
                    type="submit"
                    disabled={submitting || !backendOnline || !message.trim()}
                  >
                    {submitting ? (
                      <LoaderCircle className="spin" size={17} />
                    ) : (
                      <Send size={17} />
                    )}
                    {submitting ? "Submitting…" : "Analyze and create case"}
                  </button>
                </form>

                <div className="panel">
                  <div className="panel-heading">
                    <div>
                      <span className="eyebrow">HOW IT WORKS</span>
                      <h2>Investigation workflow</h2>
                    </div>
                  </div>
                  <WorkflowItem
                    number="01"
                    title="Initial checks"
                    detail="Extract URLs and look for configured urgency indicators."
                  />
                  <WorkflowItem
                    number="02"
                    title="Persist a case"
                    detail="Store the submitted message and case in FalkorDB."
                  />
                  <WorkflowItem
                    number="03"
                    title="Correlate evidence"
                    detail="Search graph relationships for matching domains, accounts and reports."
                  />
                  <WorkflowItem
                    number="04"
                    title="Review findings"
                    detail="Inspect evidence and limitations before deciding what it means."
                  />
                  <div className="notice">
                    <AlertTriangle size={17} />
                    <p>
                      These checks are preliminary indicators, not a definitive
                      malware or fraud verdict.
                    </p>
                  </div>
                </div>
              </section>

              {selectedCase && renderCaseDetails(selectedCase)}
            </>
          )}

          {view === "cases" && (
            <>
              <section className="page-title">
                <div>
                  <span className="eyebrow">CASE MANAGEMENT</span>
                  <h1>Investigation cases</h1>
                  <p>
                    Review case records returned by the backend.
                  </p>
                </div>
              </section>
              <section className="panel">
                <div className="panel-heading">
                  <div>
                    <span className="eyebrow">SESSION CASES</span>
                    <h2>Opened cases</h2>
                  </div>
                </div>
                <p className="muted small">
                  This list currently includes cases opened during this UI
                  session. Persistent case discovery will be added to the API.
                </p>
                {cases.length ? (
                  <CaseList cases={cases} onSelect={refreshCase} statusClass={statusClass} />
                ) : (
                  <EmptyState
                    title="No cases in this session"
                    detail="Submit a message or retrieve a case by its ID from the backend."
                    action="Analyze a message"
                    onClick={() => setView("inbox")}
                  />
                )}
              </section>
              {selectedCase && renderCaseDetails(selectedCase)}
            </>
          )}

          
          {view === "investigation" && (
            <InvestigationWorkspace />
          )}

          {view === "graph" && (
            <>
              <section className="page-title">
                <div>
                  <span className="eyebrow">INVESTIGATION WORKSPACE</span>
                  <h1>Graph explorer</h1>
                  <p>
                    Explore connected accounts, domains, messages and reports
                    directly from FalkorDB.
                  </p>
                </div>
              </section>

              
                <GraphExplorer />
              </>
            )}
          </div>
        </main>
      </div>
    );
}


function Metric({
  icon,
  label,
  value,
  note,
}: {
  icon: React.ReactNode;
  label: string;
  value: string | number;
  note: string;
}) {
  return (
    <article className="metric-card">
      <div className="metric-top">
        <span className="metric-icon">{icon}</span>
        <ArrowUpRight size={16} className="muted" />
      </div>
      <span className="metric-label">{label}</span>
      <strong className="metric-value">{value}</strong>
      <span className="metric-note">{note}</span>
    </article>
  );
}

function ServiceRow({
  name,
  detail,
  online,
}: {
  name: string;
  detail: string;
  online: boolean;
}) {
  return (
    <div className="service-row">
      <span className={`connection-dot ${online ? "online" : ""}`} />
      <div className="service-copy">
        <strong>{name}</strong>
        <small>{detail}</small>
      </div>
      <span className={`service-status ${online ? "good" : ""}`}>
        {online ? "Connected" : "Unavailable"}
      </span>
    </div>
  );
}

function WorkflowItem({
  number,
  title,
  detail,
}: {
  number: string;
  title: string;
  detail: string;
}) {
  return (
    <div className="workflow-item">
      <span className="workflow-number">{number}</span>
      <div>
        <strong>{title}</strong>
        <p>{detail}</p>
      </div>
    </div>
  );
}

function CaseList({
  cases,
  onSelect,
  statusClass,
}: {
  cases: CaseRecord[];
  onSelect: (id: string) => void;
  statusClass: (status?: string) => string;
}) {
  return (
    <div className="case-list">
      {cases.map((record) => (
        <button
          className="case-list-row"
          key={record.id}
          onClick={() => onSelect(record.id)}
        >
          <span className="case-list-icon">
            <ShieldCheck size={18} />
          </span>
          <span className="case-list-copy">
            <strong>{record.id}</strong>
            <small>{formatDate(record.created_at)}</small>
          </span>
          <span className={`status-pill ${statusClass(record.status)}`}>
            {record.status?.replaceAll("_", " ") || "unknown"}
          </span>
          <ChevronRight size={16} className="muted" />
        </button>
      ))}
    </div>
  );
}

function EmptyState({
  title,
  detail,
  action,
  onClick,
}: {
  title: string;
  detail: string;
  action: string;
  onClick: () => void;
}) {
  return (
    <div className="empty-state">
      <div className="empty-icon">
        <Clock3 size={22} />
      </div>
      <strong>{title}</strong>
      <p>{detail}</p>
      <button className="secondary-button" onClick={onClick}>
        {action}
      </button>
    </div>
  );
}

export default App;
